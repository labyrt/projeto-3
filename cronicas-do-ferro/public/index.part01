<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover" />
<meta name="theme-color" content="#16130f" />
<link rel="manifest" href="manifest.json" />
<link rel="icon" href="/icon.svg" type="image/svg+xml" />
<title>Crônicas do Ferro</title>
<style>
:root{--ink:#efe2bd;--gold:#d8b15c;--panel:#1b1712ee;--line:#6d5632;--danger:#d95d4f;--hp:#c74e47;--mp:#4b89c6;--xp:#8fbd66}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#0d0b09;color:var(--ink);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;touch-action:none;overscroll-behavior:none}
button{font:inherit;color:inherit}
#app{height:100dvh;display:flex;align-items:center;justify-content:center;background:
radial-gradient(circle at 50% 30%,#2a2118 0 22%,#110e0b 58%,#090806 100%)}
#shell{position:relative;width:min(100vw,900px);height:min(100dvh,760px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:max(8px,env(safe-area-inset-top)) max(8px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-left))}
#gameWrap{position:relative;width:min(100%,800px);aspect-ratio:5/3;border:3px solid #6e5731;box-shadow:0 0 0 2px #18120c,0 12px 40px #000a;background:#111;overflow:hidden}
canvas{display:block;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges;background:#111}
#scan{pointer-events:none;position:absolute;inset:0;background:repeating-linear-gradient(0deg,#0000 0 3px,#00000012 4px);mix-blend-mode:multiply}
#hud{position:absolute;left:8px;right:8px;top:8px;display:flex;justify-content:space-between;gap:8px;pointer-events:none;text-shadow:1px 1px #000}
.hudBox{background:#15110ccc;border:1px solid #6d5632;border-radius:5px;padding:5px 7px;box-shadow:0 2px 0 #0008;min-width:132px}
.bar{height:7px;background:#2d261d;border:1px solid #080705;margin-top:3px;position:relative;overflow:hidden}
.fill{height:100%;width:50%}.hp{background:var(--hp)}.mp{background:var(--mp)}.xp{background:var(--xp)}
#hudRight{text-align:right;min-width:150px}
#quest{position:absolute;top:8px;left:50%;transform:translateX(-50%);background:#15110ccc;border:1px solid #6d5632;padding:5px 9px;max-width:48%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:11px;pointer-events:none}
#toast{position:absolute;left:50%;bottom:58px;transform:translateX(-50%) translateY(10px);opacity:0;transition:.18s;background:#0f0d0acc;border:1px solid #8b6f3e;padding:6px 10px;max-width:80%;text-align:center;font-size:12px;pointer-events:none}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#controls{width:min(100%,800px);display:flex;justify-content:space-between;align-items:end;padding:0 4px;gap:12px}
#dpad{display:grid;grid-template:44px 44px 44px/44px 44px 44px;gap:5px}
.ctrl,.act{border:1px solid #6d5632;background:linear-gradient(#2a2119,#17120e);box-shadow:0 3px 0 #090706;border-radius:8px;touch-action:none}
.ctrl{width:44px;height:44px;font-size:18px}.ctrl:active,.act:active{transform:translateY(2px);box-shadow:0 1px 0 #090706;background:#332719}
#up{grid-column:2}#left{grid-column:1;grid-row:2}#down{grid-column:2;grid-row:2}#right{grid-column:3;grid-row:2}
#actions{display:grid;grid-template-columns:repeat(3,58px);gap:7px;align-items:end}
.act{height:48px;font-size:10px;font-weight:700;letter-spacing:.3px}.act.primary{height:58px;border-color:#8f6b32;background:linear-gradient(#5d4020,#2b1b11)}
#overlay{position:fixed;inset:0;background:radial-gradient(circle at 50% 35%,#211911f5,#090806fa 68%);display:flex;align-items:center;justify-content:center;padding:max(14px,env(safe-area-inset-top)) max(14px,env(safe-area-inset-right)) max(14px,env(safe-area-inset-bottom)) max(14px,env(safe-area-inset-left));z-index:100;overscroll-behavior:contain}
#overlay.hidden{display:none}
.panel{width:min(92vw,620px);max-height:calc(100dvh - 28px);overflow:auto;background:linear-gradient(#211a13,#15110d);border:2px solid #806438;box-shadow:0 0 0 2px #090704,0 16px 50px #000c;padding:16px;position:relative;touch-action:pan-y;scrollbar-width:thin;scrollbar-color:#806438 #15110d}
.panel h1,.panel h2{margin:0 0 10px;color:#f3d88d;text-transform:uppercase;letter-spacing:1px}.panel p{line-height:1.45;color:#d5c8a4}
.menuBtns{display:grid;gap:8px;margin-top:14px}.menuBtn,.buyBtn{border:1px solid #806438;background:#2a2117;padding:10px 12px;text-align:left}.menuBtn:hover,.buyBtn:hover{background:#382a1a}.menuBtn[disabled]{opacity:.4}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.card{border:1px solid #5e4a2c;background:#18130f;padding:10px;cursor:pointer}.card.selected{border-color:#d8b15c;box-shadow:0 0 0 1px #d8b15c inset}.card strong{color:#efd68b}.mini{font-size:11px;color:#aaa084;line-height:1.35}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.slot{min-height:70px;border:1px solid #5d492b;background:#12100d;padding:7px}.slot b{display:block;color:#ecd485;margin-bottom:3px}
.row{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid #3a2e1c}.row:last-child{border-bottom:0}.buyBtn{padding:6px 8px;white-space:nowrap}
.kbd{display:inline-block;padding:1px 5px;border:1px solid #665233;border-bottom-width:2px;background:#16110d}
.close{position:absolute;right:9px;top:8px;border:0;background:none;font-size:20px;color:#cbb98a}
#miniMap{position:absolute;right:8px;bottom:8px;width:76px;height:46px;border:1px solid #6d5632;background:#0b0907aa;pointer-events:none;image-rendering:pixelated}
#mobileInfo{display:none;width:min(100%,800px);border:1px solid #5e4a2c;background:#15110ccc;padding:9px 11px;box-shadow:0 3px 0 #090706;font-size:11px;line-height:1.35}
#mobileQuest{color:#efd68b;margin-bottom:4px}
#mobileStats{color:#aaa084}
@media (max-width:620px) and (orientation:portrait){
 #shell{justify-content:center;gap:10px;padding-top:max(8px,env(safe-area-inset-top));padding-bottom:max(8px,env(safe-area-inset-bottom))}
 #gameWrap{width:100%;margin:0}
 #mobileInfo{display:block}
 #controls{margin:0;padding:0 4px}
 #dpad{grid-template:48px 48px 48px/48px 48px 48px}.ctrl{width:48px;height:48px}
 #actions{grid-template-columns:repeat(3,56px)}.act{height:50px}.act.primary{height:60px}
 #quest{display:none}.hudBox{min-width:116px;fo