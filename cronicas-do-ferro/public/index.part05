ted='hunter';overlay.querySelectorAll('.card').forEach(el=>el.onclick=()=>{overlay.querySelectorAll('.card').forEach(x=>x.classList.remove('selected'));el.classList.add('selected');selected=el.dataset.c});
 $('back').onclick=mainMenu;$('begin').onclick=()=>newGame(selected);
}
function newGame(cid){
 localStorage.removeItem(SAVE);localStorage.removeItem(LEGACY_SAVE);freshWorld(true);let c=classes[cid];player={x:0,y:0,dir:'down',classId:cid,name:c.name,hp:c.hp,maxHp:c.hp,mp:c.mp,maxMp:c.mp,damage:c.damage,speed:c.speed,range:c.range,cool:c.cool,armor:c.armor,level:1,xp:0,xpNext:40,gold:35,weapon:1,potions:2,ore:0,relics:0,quest:0,attackCd:0,invuln:0,area:'village'};bossDead=false;setupArea('village');overlay.classList.add('hidden');gameState='play';showToast('Fale com Ilyra, a Vigia.');saveGame();
}
function saveGame(){if(gameState==='menu'||!player)return;const data={version:3,savedAt:Date.now(),player,bossDead,areaVisited,progress};try{localStorage.setItem(SAVE,JSON.stringify(data));localStorage.removeItem(LEGACY_SAVE)}catch(e){}scheduleCloudSave(data)}
function loadGame(){const d=readLocalSave();return applySave(d)}
function updateHUD(){
 $('heroName').textContent=`${classes[player.classId].name} · Arma +${player.weapon}`;$('hpFill').style.width=`${100*player.hp/player.maxHp}%`;$('mpFill').style.width=`${100*player.mp/player.maxMp}%`;$('xpFill').style.width=`${100*player.xp/player.xpNext}%`;$('areaName').textContent=areaDefs[player.area].name;$('money').textContent=`${player.gold} ouro`;$('lvl').textContent=`Nv. ${player.level}`;
 const qs=['Fale com Ilyra na vila','Entre na Floresta de Nargan','Encontre a Cripta do Sino Negro','Desça ao Abismo','Derrote o Guardião do Abismo','Volte para Ilyra'];const q=qs[player.quest]||'A caça continua';$('quest').textContent='Objetivo: '+q;$('mobileQuest').textContent='Objetivo: '+q;$('mobileStats').textContent=`${areaDefs[player.area].name} · ${player.gold} ouro · ${player.potions} ${player.potions===1?'poção':'poções'} · ${player.ore} ${player.ore===1?'minério':'minérios'}`;
}
function gainXP(n){player.xp+=n;while(player.xp>=player.xpNext){player.xp-=player.xpNext;player.level++;player.xpNext=Math.floor(player.xpNext*1.35);player.maxHp+=10;player.maxMp+=5;player.damage+=2;player.hp=player.maxHp;player.mp=player.maxMp;showToast(`Nível ${player.level}! Seus atributos aumentaram.`)}updateHUD()}
function interact(){
 if(gameState!=='play')return;
 let near=npcs.find(n=>dist(player,n)<22);if(near){if(near.type==='shop')shop();else if(near.type==='smith')smith();else elder();return;}
 let chest=chests.find(c=>dist(player,c)<21);if(chest){openChest(chest);return;}
 let sec=secrets.find(s=>!s.open&&Math.hypot(player.x-(s.tx*T+8),player.y-(s.ty*T+8))<25);if(sec){sec.open=true;progress.openedSecrets[sec.id]=true;world[player.area][sec.ty][sec.tx]='0';showToast('Passagem secreta descoberta.');burst(sec.tx*T+8,sec.ty*T+8,'#c7b58a',14);saveGame();return;}
 let p=portals.find(p=>dist(player,p)<18);if(p&&portalLock<=0){transition(p.to);return;}
 showToast('Nada para interagir aqui.');
}
function openChest(c){if(c.open){showToast('O baú está vazio.');return}c.open=true;c.anim=.35;progress.openedChests[c.id]=true;let s=[];for(const[k,v]of Object.entries(c.loot)){player[k]=(player[k]||0)+v;const label=k==='gold'?'ouro':k==='ore'?(v===1?'minério':'minérios'):k==='potions'?(v===1?'poção':'poções'):(v===1?'relíquia':'relíquias');s.push(`${v} ${label}`)}burst(c.x,c.y,'#e4bd62',18);showToast('Baú: '+s.join(' · '));updateHUD();saveGame()}
function shop(){openOverlay(`<div class="panel"><button class="close" id="x">×</button><h2>Mara, Mercadora</h2><p>“As florestas engolem imprudentes. Leve algo para voltar vivo.”</p><div class="row"><div><b>Poção de Ervas</b><div class="mini">Recupera 35 de vida</div></div><button class="buyBtn" data-buy="potion">18 ouro</button></div><div class="row"><div><b>Tônico Arcano</b><div class="mini">Recupera toda a energia</div></div><button class="buyBtn" data-buy="mana">22 ouro</button></div><div class="row"><div><b>Mapa de Caçador</b><div class="mini">Rumor: “a terceira galeria da cripta soa oca”.</div></div><button class="buyBtn" data-buy="hint">12 ouro</button></div><p class="mini">Seu ouro: ${player.gold}</p></div>`);$('x').onclick=closeOverlay;overlay.querySelectorAll('[data-buy]').forEach(b=>b.onclick=()=>buy(b.dataset.buy));}
function buy(t){let cost=t==='potion'?18:t==='mana'?22:12;if(player.gold<cost){showToast('Ouro insuficiente.');return}player.gold-=cost;if(t==='potion'){player.potions++;showToast('Poção adicionada à bolsa.')}else if(t==='mana'){player.mp=player.maxMp;showToast('Energia restaurada.')}else showToast('A parede oeste da cripta esconde algo.');closeOverlay();updateHUD();saveGame()}
function smith(){let cost=35+player.weapon*30,ore=Math.max(1,player.weapon);openOverlay(`<div class="panel"><button class="close" id="x">×</button><h2>Borin, Ferreiro</h2><p>“Monstro nenhum respeita lâmina cega.”</p><div class="row"><div><b>Reforçar arma +${player.weapon} → +${player.weapon+1}</b><div class="mini">+3 dano permanente · requer ${ore} minério</div></div><button class="buyBtn" id="upgrade">${cost} ouro</button></div><p class="mini">Você possui ${player.gold} ouro e ${player.ore} minério.</p></div>`);$('x').onclick=closeOverlay;$('upgrade').onclick=()=>{if(player.gold<cost||player.ore<ore){showToast('Faltam recursos.');return}player.gold-=cost;player.ore-=ore;player.weapon++;player.damage+=3;showToast(`Arma reforçada para +${player.weapon}.`);closeOverlay();updateHUD();saveGame()}}
function elder(){
 let text='';if(player.quest===0){text='“As criaturas voltaram. Cruze o portão leste, atravesse Nargan e encontre a Cripta do Sino Negro.”';player.quest=1}else if(player.quest<4){text='“A origem ainda respira sob a mata. Não volte sem descobrir o que guarda o abismo.”'}else if(player.quest===5){text='“Então acabou. Cendral terá outra manhã. E você, caçador, agora tem uma história.”';player.quest=6;player.gold+=150}else{text='“A estrada não termina aqui. A floresta sempre cria novos rumores.”'}
 openOverlay(`<div class="panel"><button class="close" id="x">×</button><h2>Ilyra, Vigia</h2><p>${text}</p><button class="menuBtn" id="ok">CONTINUAR</button></div>`);$('x').onclick=$('ok').onclick=()=>{closeOverlay();updateHUD();saveGame()};updateHUD();
}
function inventory(){if(gameState!=='play')return;openOverlay(`<div class="panel"><button class="close" id="x">×</button><h2>Bolsa de Campo</h2><div class="grid"><div class="slot"><