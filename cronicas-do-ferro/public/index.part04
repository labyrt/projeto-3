tions={}){const res=await fetch(path,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(options.headers||{})},...options});let body={};try{body=await res.json()}catch(e){}if(!res.ok){const err=new Error(body.error||'Falha na conexão.');err.status=res.status;throw err}return body}
function setSyncState(state,msg=''){cloud.syncState=state;cloud.lastError=msg}
async function cloudSave(data){if(!cloud.user)return;cloud.busy=true;setSyncState('syncing');try{await api('/api/save',{method:'PUT',body:JSON.stringify({data})});setSyncState('ok')}catch(e){setSyncState('error',e.message)}finally{cloud.busy=false}}
function scheduleCloudSave(data){if(!cloud.user)return;cloud.pending=data;clearTimeout(cloud.timer);cloud.timer=setTimeout(()=>{const next=cloud.pending;cloud.pending=null;cloudSave(next)},700)}
async function reconcileCloudSave(){if(!cloud.user)return;let local=readLocalSave();let remote=null;try{const r=await api('/api/save');remote=r.data||null}catch(e){setSyncState('error',e.message);return}const lt=Number(local?.savedAt||0),rt=Number(remote?.savedAt||0);if(validSave(remote)&&rt>=lt){localStorage.setItem(SAVE,JSON.stringify(remote));setSyncState('ok')}else if(validSave(local)){await cloudSave(local)}else setSyncState('ok')}
async function initAccount(){try{const r=await api('/api/auth/me');cloud.user=r.user||null;if(cloud.user){await reconcileCloudSave()}}catch(e){cloud.user=null;setSyncState('guest')}}
function accountBadge(){if(!cloud.user)return `<div class="authStatus"><span><span class="authDot"></span>Jogando como convidado</span><span class="syncPill">save local</span></div>`;const cls=cloud.syncState==='ok'?'ok':cloud.syncState==='error'?'warn':'';const text=cloud.syncState==='syncing'?'sincronizando…':cloud.syncState==='error'?'falha no sync':'nuvem ativa';return `<div class="authStatus"><span><span class="authDot online"></span><strong>${escapeHtml(cloud.user.username)}</strong></span><span class="syncPill ${cls}">${text}</span></div>`}
function escapeHtml(v){return String(v).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
function mainMenu(){gameState='menu';const has=validSave(readLocalSave());overlay.classList.remove('hidden');overlay.innerHTML=`<div class="panel"><h1>Crônicas do Ferro</h1><p>Um RPG de exploração medieval sobre caçadores de monstros, ruínas esquecidas e uma vila que depende do que você traz das masmorras.</p>${accountBadge()}<div class="menuBtns"><button class="menuBtn" id="newGame">NOVO JOGO</button><button class="menuBtn" id="continueGame" ${has?'':'disabled'}>CONTINUAR</button><button class="menuBtn" id="accountBtn">${cloud.user?'CONTA E SAVE NA NUVEM':'ENTRAR / CRIAR CONTA'}</button><button class="menuBtn" id="how">CONTROLES</button></div><p class="mini">O progresso é salvo no aparelho. Com uma conta, também é sincronizado na nuvem.</p></div>`;
 $('newGame').onclick=classSelect;$('continueGame').onclick=()=>{if(loadGame()){overlay.classList.add('hidden');gameState='play'}};$('accountBtn').onclick=accountMenu;$('how').onclick=help;
}
function accountMenu(){if(cloud.user){openOverlay(`<div class="panel"><button class="close" id="x">×</button><h2>Conta do caçador</h2>${accountBadge()}<p class="cloudNote">Seu save é sincronizado automaticamente. A versão mais recente entre aparelho e nuvem é preservada ao entrar.</p><div class="menuBtns"><button class="menuBtn" id="syncNow">SINCRONIZAR AGORA</button><button class="menuBtn" id="logout">SAIR DA CONTA</button></div></div>`);$('x').onclick=mainMenu;$('syncNow').onclick=async()=>{const d=readLocalSave();if(validSave(d)){await cloudSave(d);showToast('Save sincronizado.')}mainMenu()};$('logout').onclick=async()=>{try{await api('/api/auth/logout',{method:'POST',body:'{}'})}catch(e){}cloud.user=null;setSyncState('guest');mainMenu()};return}
 openOverlay(`<div class="panel"><button class="close" id="x">×</button><h2>Conta do caçador</h2><p>Crie uma conta para continuar a mesma jornada em outros aparelhos.</p><div class="field"><label>Nome de caçador</label><input id="authUser" autocomplete="username" maxlength="20" placeholder="3 a 20 caracteres"></div><div class="field"><label>Senha</label><input id="authPass" type="password" autocomplete="current-password" maxlength="72" placeholder="mínimo de 8 caracteres"></div><div id="authError" class="authError"></div><div class="menuBtns"><button class="menuBtn" id="login">ENTRAR</button><button class="menuBtn" id="register">CRIAR CONTA</button></div><p class="cloudNote">Não pedimos e-mail. Guarde sua senha: esta versão não possui recuperação automática.</p></div>`);$('x').onclick=mainMenu;const submit=async(mode)=>{const u=$('authUser').value.trim(),p=$('authPass').value;$('authError').textContent='';if(!/^[A-Za-z0-9_.-]{3,20}$/.test(u)){ $('authError').textContent='Use 3–20 caracteres: letras, números, ponto, _ ou -.';return}if(p.length<8){$('authError').textContent='A senha precisa ter pelo menos 8 caracteres.';return}try{$('login').disabled=$('register').disabled=true;const r=await api('/api/auth/'+mode,{method:'POST',body:JSON.stringify({username:u,password:p})});cloud.user=r.user;await reconcileCloudSave();mainMenu();showToast(mode==='register'?'Conta criada. Save na nuvem ativado.':'Conta conectada.')}catch(e){$('authError').textContent=e.message;$('login').disabled=$('register').disabled=false}};$('login').onclick=()=>submit('login');$('register').onclick=()=>submit('register');
}
function help(){openOverlay(`<div class="panel"><button class="close" id="x">×</button><h2>Como jogar</h2><p><span class="kbd">WASD</span> mover · <span class="kbd">Espaço</span> atacar · <span class="kbd">E</span> interagir/usar · <span class="kbd">I</span> inventário.</p><p>No celular, use o direcional e os três botões. Aproximar-se de pessoas, baús, entradas e paredes suspeitas revela interações.</p><p class="mini">Dica: algumas paredes da cripta parecem comuns, mas escondem câmaras.</p></div>`);$('x').onclick=mainMenu}
function classSelect(){
 openOverlay(`<div class="panel"><h2>Escolha sua classe</h2><div class="cards">${Object.entries(classes).map(([id,c],i)=>`<div class="card ${i===0?'selected':''}" data-c="${id}"><strong>${c.name}</strong><p class="mini">${c.desc}</p><p class="mini">Vida ${c.hp} · Dano ${c.damage}<br>${c.skill}</p></div>`).join('')}</div><div class="menuBtns"><button class="menuBtn" id="begin">COMEÇAR A CAÇADA</button><button class="menuBtn" id="back">VOLTAR</button></div></div>`);
 let selec