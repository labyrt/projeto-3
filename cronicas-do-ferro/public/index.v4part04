};

const itemCatalog={
 hunter_bow:{name:'Arco de Freixo',slot:'weapon',icon:'🏹',rarity:'Comum',atk:5,agi:4,classes:['hunter'],lore:'Madeira flexível de Nargan. Leve, silenciosa e confiável.'},
 guardian_blade:{name:'Espada de Cendral',slot:'weapon',icon:'⚔️',rarity:'Comum',atk:7,def:2,classes:['guardian'],lore:'Aço da guarda da vila, equilibrado para longas caçadas.'},
 occult_staff:{name:'Cajado do Véu',slot:'weapon',icon:'🔮',rarity:'Comum',atk:6,classes:['occult'],lore:'Canaliza ecos arcanos sem consumir o portador.'},
 oak_shield:{name:'Escudo da Vigia',slot:'shield',icon:'🛡️',rarity:'Comum',def:12,classes:['guardian'],lore:'Carvalho reforçado com tiras de ferro e o selo da vila.'},
 leather_armor:{name:'Gibão de Caçador',slot:'armor',icon:'🥋',rarity:'Comum',def:7,agi:2,lore:'Couro leve para atravessar mata fechada e ruínas.'},
 iron_helm:{name:'Elmo Jurado',slot:'helm',icon:'🪖',rarity:'Raro',def:10,lore:'Encontrado entre os jurados da Cripta do Sino Negro.'},
 field_boots:{name:'Botas de Estrada',slot:'boots',icon:'🥾',rarity:'Comum',agi:6,lore:'Solas leves para quem nunca sabe onde a estrada termina.'},
 silver_ring:{name:'Anel da Lua Baixa',slot:'ring',icon:'💍',rarity:'Raro',atk:3,agi:5,lore:'Prata antiga que parece fria mesmo diante de uma fogueira.'},
 star_amulet:{name:'Amuleto do Alvorecer',slot:'amulet',icon:'💠',rarity:'Épico',atk:7,def:6,agi:4,lore:'Um fragmento de estrela lapidado por mãos esquecidas.'},
 mercenary_armor:{name:'Armadura do Peregrino',slot:'armor',icon:'🛡️',rarity:'Raro',def:16,agi:-1,lore:'Placas curtas e couro grosso. Feita para voltar para casa.'},
 warden_blade:{name:'Lâmina do Guardião',slot:'weapon',icon:'🗡️',rarity:'Lendário',atk:18,def:5,lore:'A lâmina mantém um brilho violeta mesmo longe do abismo.'},
 ember_charm:{name:'Talismã da Forja',slot:'amulet',icon:'🔥',rarity:'Raro',atk:5,def:3,lore:'Borin jura que o metal guarda a memória de cada martelada.'}
};
const slotNames={weapon:'Arma',shield:'Escudo',helm:'Elmo',armor:'Armadura',boots:'Botas',ring:'Anel',amulet:'Amuleto'};
function starterForClass(cid){return cid==='guardian'?{weapon:'guardian_blade',shield:'oak_shield',armor:'leather_armor',boots:'field_boots'}:cid==='occult'?{weapon:'occult_staff',armor:'leather_armor',boots:'field_boots'}:{weapon:'hunter_bow',armor:'leather_armor',boots:'field_boots'}}
function ensurePlayerRpgData(){
 if(!player.inventory)player.inventory=[]; if(!player.equipment)player.equipment=starterForClass(player.classId);
 for(const id of Object.values(player.equipment))if(id&&!player.inventory.includes(id))player.inventory.push(id);
 player.skillCd=Number(player.skillCd)||0;player.dodgeCd=Number(player.dodgeCd)||0;player.combo=Number(player.combo)||0;player.comboTimer=Number(player.comboTimer)||0;
}
function addItem(id){if(!itemCatalog[id])return false;ensurePlayerRpgData();if(player.inventory.includes(id)){player.gold+=Math.max(10,Math.round((itemCatalog[id].atk||0)*3+(itemCatalog[id].def||0)*2+12));showToast(`${itemCatalog[id].name} convertido em ouro.`);return false}player.inventory.push(id);showToast(`Novo item: ${itemCatalog[id].name}`);return true}
function equippedItems(){ensurePlayerRpgData();return Object.values(player.equipment).filter(Boolean).map(id=>itemCatalog[id]).filter(Boolean)}
function gearBonus(stat){return equippedItems().reduce((s,i)=>s+(i[stat]||0),0)}
function attackPower(){return Math.round(player.damage+player.weapon*2+gearBonus('atk'))}
function effectiveArmor(){return clamp(player.armor+gearBonus('def')/180,0,.65)}
function effectiveSpeed(){return Math.max(42,player.speed+gearBonus('agi')*.55)}

const areaDefs={
 village:{name:'Vila de Cendral',theme:'village',map:[
 '1111111111111111111111111','1000000000000000000000001','1000111100000000111100001','1000111100000000111100001','1000000000000000000000001','1000000000000000000000001','1000000000000000000000001','1000000000000000000000000','1000000000000000000000001','1000011110000111100000001','1000011110000111100000001','1000000000000000000000001','1000000000000000000000001','1000000000000000000000001','1111111111111111111111111']},
 forest:{name:'Floresta de Nargan',theme:'forest',map:[
 '1111111111111111111111111','1111000001110000011110001','1100000001110000000010001','1100110000000000110010001','1000111100000011110010001','1000000000000000000000001','1110001100111001110000001','0000000000000000000000001','1110000110001110000110001','1000000110000000000110001','1001111111000111100000001','1000000000000111100011001','1000111000000000000011001','1000000000000000000000001','1111111111111111111111111']},
 dungeon1:{name:'Cripta do Sino Negro',theme:'dungeon',map:[
 '1111111111111111111111111','1000000010000000000000001','1011111110111111111111101','1010000010000000000000101','1011111111110111111100101','1010000000010100000100101','1011111100010101110100101','1000000100000101010100001','1111100111111101010111101','1000100000000001010000101','1010111111111101011110101','1010000000000001000010101','1011111111110111111010101','1000000000000000000000001','1111111111111111111111111']},
 dungeon2:{name:'Abismo do Guardião',theme:'dungeon',map:[
 '1111111111111111111111111','1000000000000000000000001','1011111111000001111111101','1010000011000001100000101','1010000011000001100000101','1010000000000000000000101','1011110000011100001111101','1000000000000000000000001','1011110000011100001111101','1010000000000000000000101','1010000011000001100000101','1010000011000001100000101','1011111111000001111111101','1000000000000000000000001','1111111111111111111111111']}
};
let world={};
let player={x:8*T,y:7*T,dir:'down',classId:'hunter',name:'Ari',hp:82,maxHp:82,mp:60,maxMp:60,damage:13,speed:74,range:105,cool:0.44,armor:.05,level:1,xp:0,xpNext:40,gold:35,weapon:1,potions:2,ore:0,relics:0,quest:0,attackCd:0,invuln:0,area:'village'};
let enemies=[],projectiles=[],particles=[],npcs=[],chests=[],portals=[],secrets=[],bossDead=false,areaVisited={},progress={openedChests:{},openedSecrets:{}};
function freshWorld(resetProgress=false){
 world={village:areaDefs.village.map.map(r=>r.split('')),forest:areaDefs.forest.map.map(r=>r.split('')),dungeon1:areaDefs.dungeon1.map.map(r=>r.split('')),dungeon2:areaDefs.dungeon2.map.map(r=>r.split(''))};
 if(resetProgress){bossDead=false;areaVisited={};progress={openedChests:{},openedSecrets:{}}}
}
freshWorld();
function px(tx,ty){return{x:tx*T+8,y:ty*T+8}}
function setupArea(id,from,keepPosition=false){
 player.area=id; enemies=[];projectiles=[];particles=[];npcs=[];chests=[];portals=[];secrets=[];
 if(id==='village'){
  if(!keepPosition){if(from==='forest')Object.assign(player,px(22,7));else Object.assign(player,px(6,7));}
  npcs=[{...px(6,6),type:'shop',name:'Mara, Mercadora'},{...px(10,6),type:'smith',name:'Borin, Ferreiro'},{...px(14,6),type:'elder',name:'Ilyra, Vigia'}];
  portals.push({x:24*T+7,y:7*T+8,to:'forest',r:12});
  chests.push({id:'village_cache',...px(20,11),open:!!progress.openedChests.village_cache,anim:0,loot:{gold:18,potions:1}});
 } else if(id==='forest'){
  if(!keepPosition){if(from==='village')Object.assign(player,px(1,7));else if(from==='dungeon1')Object.assign(player,px(19,2));else Object.assign(player,px(1,7));}
  portals.push({x:0*T+8,y:7*T+8,to:'village',r:12});
  portals.push({...px(21,2),to:'dungeon1',r:12,kind:'door'});
  chests.push({id:'forest_chest',...px(17,9),open:!!progress.openedChests.forest_chest,anim:0,loot:{gold:34,ore:2,items:['silver_ring']}});
  spawnEnemies('wolf',7,[[6,3],[12,5],[18,3],[20,7],[7,11],[14,12],[19,11]]);
  spawnEnemies('slime',4,[[3,5],[9,8],[15,8],[19,12]]);
 } else if(id==='dungeon1'){
  if(!keepPosition){if(from==='forest')Object.assign(player,px(2,13));else if(from==='dungeon2')Object.assign(player,px(21,1));else Object.assign(player,px(2,13));}
  portals.push({...px(1,13),to:'forest',r:12});
  portals.push({...px(22,1),to:'dungeon2',r:12,kind:'stairs'});
  chests.push({id:'crypt_chest',...px(20,7),open:!!progress.openedChests.crypt_chest,anim:0,loot:{gold:56,ore:3,potions:1,items:['iron_helm']}});
  chests.push({id:'secret_chest',...px(5,3),open:!!progress.openedChests.secret_chest,anim:0,loot:{gold:90,ore:4,relics:1,items:['star_amulet']}});
  const secret={id:'crypt_secret',tx:2,ty:3,open:!!progress.openedSecrets.crypt_secret};secrets.push(secret);if(secret.open)world.dungeon1[secret.ty][secret.tx]='0';
  spawnEnemies('skeleton',8,[[5,1],[13,1],[18,1],[3,5],[9,7],[17,5],[6,11],[19,11]]);
 } else if(id==='dungeon2'){
  if(!keepPosition){if(from==='dungeon1')Object.assign(player,px(12,12));else Object.assign(player,px(12,12));}
  portals.push({...px(12,13),to:'dungeon1',r:12,kind:'stairs'});
  spawnEnemies('skeleton',6,[[4,3],[20,3],[4,11],[20,11],[8,7],[16,7]]);
  if(!bossDead) enemies.push(makeEnemy('warden',12,5));
  chests.push({id:'abyss_chest',...px(12,2),open:!!progress.openedChests.abyss_chest,anim:0,loot:{gold:120,ore:5,potions:2,items:['warden_blade']}});
 }
 areaVisited[id]=true;portalLock=.55;areaFade=.7;ensurePlayerRpgData();updateAreaBackdrop(id);updateHUD();saveGame();
}
function spawnEnemies(type,n,spots){for(let i=0;i<n;i++){let s=spots[i%spots.length];enemies.push(makeEnemy(type,s[0],s[1]));}}
function makeEnemy(type,tx,ty){
 const db={wolf:{name:'Lobo Sombrio',hp:28,dmg:8,speed:36,xp:12,gold:[3,9],r:6,color:'#84735d'},slime:{name:'Limo da Mata',hp:22,dmg:6,speed:22,xp:9,gold:[2,6],r:7,color:'#6d8e55'},skeleton:{name:'Esqueleto Jurado',hp:42,dmg:11,speed:29,xp:18,gold:[6,15],r:6,color:'#b7ad90'},warden:{name:'Guardião do Abismo',hp:260,dmg:18,speed:24,xp:160,gold:[120,180],r:11,color:'#7b4a4a',boss:true}}[type];
 return{id:Math.random(),type,x:tx*T+8,y:ty*T+8,vx:0,vy:0,hp:db.hp,maxHp:db.hp,...db,hit:0,atk:0,windup:0,special:rng(1.4,2.6),dead:false};
}
function solidAt(x,y){const tx=Math.floor(x/T),ty=Math.floor(y/T),m=world[player.area];if(tx<0||ty<0||ty>=m.length||tx>=m[0].length)return true;return m[ty][tx]==='1';}
function actorBlocked(x,y,r){for(const n of npcs)if(Math.hypot(x-n.x,y-n.y)<r+7)return true;for(const c of chests)if(!c.open&&Math.hypot(x-c.x,y-c.y)<r+7)return true;return false}
function canMove(x,y,r=5,checkActors=false){return !solidAt(x-r,y-r)&&!solidAt(x+r,y-r)&&!solidAt(x-r,y+r)&&!solidAt(x+r,y+r)&&(!checkActors||!actorBlocked(x,y,r))}
function moveEntity(e,dx,dy,dt,r=5){let nx=e.x+dx*dt,ny=e.y+dy*dt;if(canMove(nx,e.y,r,true))e.x=nx;if(canMove(e.x,ny,r,true))e.y=ny;}
function showToast(msg){toastEl.textContent=msg;toastEl.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toastEl.classList.remove('show'),1800)}
function openOverlay(html){gameState='modal';overlay.className='';overlay.innerHTML=html;overlay.classList.remove('hidden')}
function closeOverlay(){overlay.className='hidden';overlay.innerHTML='';gameState='play'}

async function api(path,options={}){const res=await fetch(path,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(options.headers||{})},...options});let body={};try{body=await res.json()}catch(e){}if(!res.ok){const err=new Error(body.error||'Falha na conexão.');err.status=res.status;throw err}return body}
function readLocalSave(){try{const raw=localStorage.getItem(SAVE)||localStorage.getItem(LEGACY_SAVE);return raw?JSON.parse(raw):null}catch(e){return null}}
async function initAccount(){try{const r=await api('/api/auth/me');cloud.user=r.user||null;cloud.status=cloud.user?'ok':'guest';if(cloud.user)await reconcileCloudSave()}catch(e){cloud.user=null;cloud.status=e.status===503?'offline':'guest';cloud.lastError=e.message}}
async function cloudSave(data){if(!cloud.user)return;cloud.status='syncing';try{await api('/api/save',{method:'PUT',body:JSON.stringify({data})});cloud.status='ok';cloud.lastError=''}catch(e){cloud.status='error';cloud.lastError=e.message}}
function scheduleCloudSave(data){if(!cloud.user)return;cloud.pending=data;clearTimeout(cloud.timer);cloud.timer=setTimeout(()=>{const d=cloud.pending;cloud.pending=null;cloudSave(d)},600)}
async function reconcileCloudSave(){if(!cloud.user)return;try{const remote=(await api('/api/save')).data||null,local=readLocalSave();const lt=Number(local?.savedAt||0),rt=Number(remote?.savedAt||0);if(remote&&rt>lt)localStorage.setItem(SAVE,JSON.stringify(remote));else if(local)await cloudSave(local);cloud.status='ok'}catch(e){cloud.status='error';cloud.lastError=e.message}}
function accountBadge(){if(!cloud.user){const st=cloud.status==='offline'?'nuvem indisponível':'save local';return `<div class="accountLine"><span><span class="cloudDot ${cloud.status==='offline'?'warn':''}"></span>Jogando como convidado</span><span>${st}</span></div>`}return `<div class="accountLine"><span><span class="cloudDot on"></span><b>${escapeHtml(cloud.user.username)}</b></span><span>${cloud.status==='syncing'?'sincronizando…':cloud.status==='error'?'falha no sync':'nuvem ativa'}</span></div>`}
function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function showAreaSplash(id,sub='Exploração · caça · segredos'){const el=$('sceneSplash');$('sceneTitle').textContent=areaDefs[id]?.name||'Crônicas do Ferro';$('sceneSub').textContent=sub;el.style.backgroundImage=`linear-gradient(180deg,#0001,#05070bdc),url('${areaArt[id]||'data:image/webp;base64,