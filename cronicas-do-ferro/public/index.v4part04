',dungeon2:'data:image/webp;base64,'};
const classPortrait={hunter:'data:image/webp;base64,',guardian:'data:image/webp;base64,',occult:'data:image/webp;base64,'};
const rng=(a,b)=>Math.random()*(b-a)+a, clamp=(v,a,b)=>Math.max(a,Math.min(b,v)), dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
const tile=(x,y)=>({x:x*T+T/2,y:y*T+T/2});
const palette={grass:'#5b6c3f',grass2:'#657848',path:'#8a704b',dirt:'#6f573a',tree:'#273d2c',tree2:'#355138',water:'#273f54',stone:'#47443d',wall:'#2d2b2a',floor:'#5b5142',wood:'#68462e',roof:'#4a2923',gold:'#e0b34e',blood:'#a8463f'};
