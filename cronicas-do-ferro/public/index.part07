ette.grass:palette.grass2;X.fillRect(xx,yy,T,T);if((y===7||x===22)&&v==='0'){X.fillStyle=palette.path;X.fillRect(xx,yy,T,T)}}else if(theme==='forest'){X.fillStyle=((x*3+y)%2)?'#405739':'#465e3d';X.fillRect(xx,yy,T,T);if(v==='0'&&((x+y)%5===0)){X.fillStyle='#6a6947';X.fillRect(xx+7,yy+6,2,2)}}else{X.fillStyle=((x+y)%2)?'#4d463b':'#51493e';X.fillRect(xx,yy,T,T);X.fillStyle='#3e382f';if((x+y)%3===0)X.fillRect(xx+2,yy+2,4,1)}if(v==='1')drawWall(x,y,theme)}}
function drawWall(x,y,theme){let xx=x*T,yy=y*T;if(theme==='forest'){X.fillStyle='#223a28';X.fillRect(xx+2,yy+5,12,11);X.fillStyle='#31523a';X.fillRect(xx,yy+2,16,9);X.fillStyle='#496b47';X.fillRect(xx+4,yy,8,5);X.fillStyle='#513721';X.fillRect(xx+7,yy+10,3,6)}else if(theme==='village'){X.fillStyle='#263d2b';X.fillRect(xx,yy+4,16,12);X.fillStyle='#3e5d3b';X.fillRect(xx+2,yy+1,12,9)}else{X.fillStyle='#282622';X.fillRect(xx,yy,16,16);X.fillStyle='#3a3732';X.fillRect(xx+1,yy+1,14,14);X.fillStyle='#2b2926';X.fillRect(xx+2,yy+7,12,2);X.fillRect(xx+7,yy+1,2,6)}}
function drawDecor(){if(player.area==='village'){drawHouse(4,2,4,2,'#65402f');drawHouse(16,2,4,2,'#3f5365');drawHouse(5,9,4,2,'#704531');drawHouse(13,9,4,2,'#57416a');for(let x=2;x<23;x+=4)drawFlower(x*T+8,12*T+8)}if(player.area==='forest'){for(let i=0;i<18;i++){let x=(i*37)%390,y=(i*59)%225;if(!solidAt(x,y)){X.fillStyle='#7d7442';X.fillRect(x,y,1,2)}}drawDoor(21,2)}if(player.area.startsWith('dungeon')){for(const s of secrets)if(!s.open){let xx=s.tx*T,yy=s.ty*T;X.fillStyle='#71695c';X.fillRect(xx+7,yy+3,1,3);X.fillRect(xx+6,yy+6,1,2);X.fillRect(xx+5,yy+8,1,2);X.fillRect(xx+6,yy+10,2,1)}}}
function drawHouse(tx,ty,w,h,roof){let x=tx*T,y=ty*T;X.fillStyle='#6b5b46';X.fillRect(x,y+10,w*T,h*T-10);X.fillStyle=roof;X.fillRect(x-3,y+4,w*T+6,10);X.fillStyle='#2b2118';X.fillRect(x+w*T/2-4,y+h*T-10,8,10);X.fillStyle='#d59d4c';X.fillRect(x+7,y+17,4,4)}
function drawFlower(x,y){X.fillStyle='#d5c7a0';X.fillRect(x-1,y,3,1);X.fillStyle='#7d9254';X.fillRect(x,y+1,1,2)}
function drawDoor(tx,ty){let x=tx*T,y=ty*T;X.fillStyle='#1c1918';X.fillRect(x+2,y+2,12,14);X.fillStyle='#72583a';X.fillRect(x+4,y+4,8,12);X.fillStyle='#d0a957';X.fillRect(x+10,y+10,1,1)}
function drawEntities(){
 for(const p of portals){if(p.kind==='stairs'){X.fillStyle='#2b2824';X.fillRect(p.x-7,p.y-5,14,10);X.fillStyle='#706657';for(let i=0;i<4;i++)X.fillRect(p.x-6+i*3,p.y-4+i*2,8,1)}else if(p.kind==='door')drawDoor(Math.floor(p.x/T),Math.floor(p.y/T))}
 const render=[];for(const c of chests)render.push({y:c.y,fn:()=>drawChest(c)});for(const n of npcs)render.push({y:n.y,fn:()=>drawNPC(n)});for(const e of enemies)if(!e.dead)render.push({y:e.y,fn:()=>drawEnemy(e)});render.push({y:player.y,fn:drawPlayer});render.sort((a,b)=>a.y-b.y);for(const r of render)r.fn();
 for(const p of projectiles){if(p.kind==='arrow'){X.fillStyle='#d8c59b';X.fillRect(p.x-2,p.y-1,5,2)}else{X.fillStyle='#b48ad4';X.fillRect(p.x-3,p.y-3,6,6);X.fillStyle='#e4c5ff';X.fillRect(p.x-1,p.y-1,2,2)}}
}
function drawPlayer(){let c=classes[player.classId],x=Math.round(player.x),step=isMoving?(Math.sin(walkPhase)>0?1:0):0,y=Math.round(player.y)-step,blink=player.invuln>0&&Math.floor(performance.now()/60)%2===0;if(blink)return;X.fillStyle='#1b1715';X.fillRect(x-4,y+2,8,6);X.fillStyle=c.color;X.fillRect(x-5,y-3,10,7);X.fillStyle='#d7b28b';X.fillRect(x-3,y-7,6,5);X.fillStyle='#2f261f';X.fillRect(x-4,y-8,8,2);X.fillStyle='#17130f';if(isMoving){X.fillRect(x-4,y+7+(step?0:1),3,2);X.fillRect(x+1,y+7+(step?1:0),3,2)}let d=dirVec(player.dir);X.fillStyle='#e3cf9c';X.fillRect(x+d.x*7-1,y+d.y*7-1,3,3)}
function drawNPC(n){let x=n.x,y=n.y,col=n.type==='shop'?'#b06f5b':n.type==='smith'?'#8c6b52':'#6f7f9f';X.fillStyle='#221a16';X.fillRect(x-4,y+2,8,6);X.fillStyle=col;X.fillRect(x-5,y-3,10,7);X.fillStyle='#d3ad86';X.fillRect(x-3,y-7,6,5);if(dist(player,n)<23){X.fillStyle='#f0d98d';X.fillRect(x-2,y-14,4,1);X.fillRect(x-2,y-12,4,1);X.fillRect(x-1,y-11,2,2)}}
function drawChest(c){let x=c.x,y=c.y,lift=c.open?Math.max(2,Math.round((c.anim||0)*10)):0;X.fillStyle=c.open?'#3b2b1d':'#5e3d23';X.fillRect(x-6,y-4,12,8);X.fillStyle='#b38a42';X.fillRect(x-6,y-1,12,2);X.fillRect(x-1,y-3,2,5);if(c.open){X.fillStyle='#18120e';X.fillRect(x-5,y-6-lift,10,2);X.fillStyle='#b38a42';X.fillRect(x-5,y-7-lift,10,1)}}
function drawEnemy(e){let x=Math.round(e.x),y=Math.round(e.y)+(e.boss?Math.round(Math.sin(performance.now()/180)):0);if(e.type==='wolf'){X.fillStyle=e.hit?'#e7cf9d':e.color;X.fillRect(x-7,y-3,12,7);X.fillRect(x+4,y-1,4,4);X.fillStyle='#d55';X.fillRect(x+6,y,1,1)}else if(e.type==='slime'){X.fillStyle=e.hit?'#d9e5a6':e.color;X.fillRect(x-6,y-3,12,7);X.fillRect(x-4,y-5,8,2);X.fillStyle='#1a2417';X.fillRect(x-3,y-1,2,2);X.fillRect(x+2,y-1,2,2)}else{X.fillStyle=e.hit?'#eee0b6':e.color;X.fillRect(x-4,y-4,8,9);X.fillStyle='#28231f';X.fillRect(x-3,y-7,6,4);X.fillStyle='#c94f46';X.fillRect(x-2,y-6,1,1);X.fillRect(x+1,y-6,1,1);if(e.boss){X.strokeStyle='#a46969';X.strokeRect(x-10,y-10,20,20)}}if(e.hp<e.maxHp){X.fillStyle='#201a16';X.fillRect(x-8,y-12,16,2);X.fillStyle='#bd554d';X.fillRect(x-8,y-12,16*e.hp/e.maxHp,2)}}
function drawParticles(){for(const p of particles){X.globalAlpha=Math.max(0,p.life/p.max);X.fillStyle=p.color;X.fillRect(p.x,p.y,p.size,p.size)}X.globalAlpha=1}
function drawMini(){const m=world[player.area],sw=100/m[0].length,sh=60/m.length;MX.clearRect(0,0,100,60);for(let y=0;y<m.length;y++)for(let x=0;x<m[y].length;x++){MX.fillStyle=m[y][x]==='1'?'#1b1b18':'#776b4f';MX.fillRect(x*sw,y*sh,Math.ceil(sw),Math.ceil(sh))}MX.fillStyle='#d8b15c';MX.fillRect(player.x/T*sw-1,player.y/T*sh-1,3,3);for(const e of enemies)if(!e.dead&&e.boss){MX.fillStyle='#b94c4c';MX.fillRect(e.x/T*sw-1,e.y/T*sh-1,3,3)}}
function loop(t){let dt=Math.min(.033,(t-last)/1000||0);last=t;update(dt);draw();requestAnimationFrame(loop)}
window.addEventListener('keydown',e=>{let k=e.key.toLowerCase();keys[k]=true;if([' ','arrowup','arrowdown','arrowleft','arrowright'].includes(k))e.preventDefault();if(k===' ')attack();if(k==='e')interact();if(k==='i')inventory();if(k==='escape'&&gameState==='modal'){const x=$('x'),back=$('back');if(x)x.click();else if(back)back.click()}});window.addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);window.addEventListener('blur',()=>{keys={};touchKeys={}});document.addEventListener('visibilitychange',()=>{if(document.hidden){keys={};touchKeys={};saveGame()}});
function bindHold(id,name){let el=$(id);let on=e=>{e.preventDefault();touchKeys[name]=true},off=e=>{e.preventDefault();touchKeys[n