');background-position:center;background-size:cover}
#overlay.inventory-screen{background-image:linear-gradient(180deg,#06101bdc,#050709f2),url('data:image/webp;base64,');background-position:center;background-size:cover}
.titleCard{width:min(92vw,500px);background:linear-gradient(180deg,#071322f4,#050a12fa);border:1px solid #ddb25b;box-shadow:0 0 0 2px #06080b,0 15px 48px #000b;padding:14px 16px;border-radius:8px;color:#f5e8c2;margin-bottom:1vh}
.titleCard h1{font-family:Georgia,serif;color:#f5d77f;text-align:center;letter-spacing:.06em;margin:0 0 4px;text-shadow:0 2px 8px #000}.titleCard .subtitle{text-align:center;color:#c8b27d;font-size:10px;letter-spacing:.18em;text-transform:uppercase;margin-bottom:10px}
.authFields{display:grid;gap:7px}.authFields input{width:100%;font:inherit;font-size:16px;background:#050a10e8;border:1px solid #866735;color:#f7ebcb;padding:10px;border-radius:4px;outline:none;user-select:text}.authFields input:focus{border-color:#e2bd68;box-shadow:0 0 0 1px #e2bd6866}
.titleActions{display:grid;gap:7px;margin-top:9px}.heroBtn{border:1px solid #d8ad58;background:linear-gradient(180deg,#174476,#0c2648);color:#ffe9ad;padding:11px 12px;font-weight:800;letter-spacing:.08em;border-radius:4px}.heroBtn.secondary{background:linear-gradient(#161b23,#0b0e14);color:#e7d6ac}.heroBtn.ghost{background:#07101bcc;color:#c9b98f;border-color:#735b37}.heroBtn:disabled{opacity:.45}
.accountLine{display:flex;justify-content:space-between;gap:8px;align-items:center;border:1px solid #4b3c25;background:#07101bcc;padding:7px 9px;border-radius:4px;font-size:11px;margin-bottom:8px}.cloudDot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#7e7566;margin-right:6px}.cloudDot.on{background:#7cac77;box-shadow:0 0 8px #7cac77}.cloudDot.warn{background:#c58a62}
.authError{color:#e28b80;min-height:16px;font-size:11px;margin-top:5px}.fine{font-size:10px;color:#9f987f;line-height:1.35}
.classPanel{width:min(94vw,760px);background:#06101bea;border:1px solid #b78c44;padding:14px;border-radius:8px;max-height:calc(100dvh - 24px);overflow:auto;touch-action:pan-y}.classPanel h2{font-family:Georgia,serif;color:#f3d27f;text-align:center;margin:0 0 10px}.classPanel .cards{grid-template-columns:repeat(3,1fr)}.classPanel .card{background:linear-gradient(#102038e8,#080e18f2);border-color:#685333;border-radius:7px;min-height:150px}.classPanel .card.selected{border-color:#e2bc65;box-shadow:0 0 0 1px #e2bc65 inset,0 0 18px #d9a94425}.classIcon{font-size:30px;margin-bottom:8px}.classPortrait{width:76px;height:104px;object-fit:cover;object-position:top;border:1px solid #8a6837;border-radius:5px;float:right;margin:0 0 6px 8px;image-rendering:auto}
.panel{background:linear-gradient(#0b1828f4,#070b12f8);border-color:#b38946;color:#f1e1b9}.panel h1,.panel h2{font-family:Georgia,serif;color:#f1d17c}.menuBtn,.buyBtn{background:linear-gradient(#142239,#0b111d);border-color:#8a6837}.menuBtn:hover,.buyBtn:hover{background:#1b2d49}
/* Inventory */
.invShell{width:min(96vw,820px);max-height:calc(100dvh - 20px);overflow:auto;touch-action:pan-y;background:#06101bf4;border:1px solid #c39446;border-radius:9px;padding:12px;box-shadow:0 18px 50px #000b}.invHeader{display:flex;align-items:center;justify-content:space-between;gap:8px;border-bottom:1px solid #6c5532;padding:2px 0 10px;margin-bottom:10px}.invHeader h2{font-family:Georgia,serif;color:#f1cf78;margin:0}.resources{font-size:10px;color:#cfbd91;display:flex;gap:9px;flex-wrap:wrap}.invTop{display:grid;grid-template-columns:minmax(120px,.8fr) 1fr 1fr;gap:10px}.heroPaper{min-height:260px;border:1px solid #6f5732;border-radius:6px;background:radial-gradient(circle at 50% 35%,#18375b,#070c13 70%);position:relative;overflow:hidden;display:flex;align-items:flex-end;justify-content:center}.heroPaper:before{content:"";position:absolute;inset:0;background-image:var(--hero-art);background-size:cover;background-position:top center;opacity:.72;filter:saturate(.9) contrast(1.02)}.heroSilhouette{position:relative;z-index:1;font-size:70px;filter:drop-shadow(0 7px 8px #000);padding-bottom:28px}.equipSlots{display:grid;grid-template-columns:repeat(2,1fr);gap:6px;align-content:start}.eqSlot{min-height:74px;border:1px solid #5e4930;background:#07111d;border-radius:5px;padding:6px;display:flex;flex-direction:column;justify-content:center;text-align:center;gap:4px}.eqSlot b{font-size:10px;color:#cdb989}.eqSlot button{border:0;background:none;color:#f3dfaa;font:inherit;font-size:11px;min-height:36px}.statBox{border:1px solid #5e4930;background:#07111d;border-radius:5px;padding:10px}.statBox h3{font-family:Georgia,serif;color:#f2d078;margin:0 0 4px}.statRow{display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #2d2b2a;font-size:11px}.statRow:last-child{border:0}.invTabs{display:flex;gap:5px;margin:10px 0 8px;overflow-x:auto;scrollbar-width:none}.invTab{min-width:110px;border:1px solid #665033;background:#0a1422;padding:8px;color:#cdbd96;border-radius:4px}.invTab.active{background:#12386a;border-color:#d4a952;color:#ffe8aa}.invBottom{display:grid;grid-template-columns:1.3fr .8fr;gap:10px}.itemGrid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.itemTile{position:relative;aspect-ratio:1;border:1px solid #51402c;background:linear-gradient(#0c1725,#060c14);border-radius:5px;color:#ead7a6;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:4px;font-size:9px;min-width:0}.itemTile .ico{font-size:23px;line-height:1}.itemTile.selected{border-color:#f0ba4f;box-shadow:0 0 12px #e2a73d66}.itemTile.equipped:after{content:'E';position:absolute}.itemDetail{border:1px solid #5e4930;background:#07111d;border-radius:5px;padding:10px;min-height:210px}.itemDetail h3{font-family:Georgia,serif;color:#f1cd72;margin:0 0 3px}.rarity{font-size:10px;color:#b99bca}.itemLore{font-family:Georgia,serif;font-size:11px;color:#b8aa88;line-height:1.45}.invActions{display:flex;gap:6px;margin-top:9px;flex-wrap:wrap}.invActions button{flex:1;min-width:110px;border:1px solid #9a7339;background:linear-gradient(#153d70,#0b2648);padding:9px;color:#f8e2a5}.invActions button.danger{background:linear-gradient(#6d2924,#371411);border-color:#9c4d45}.invActions button:disabled{opacity:.35}
#comboBadge{position:absolute;left:10px;bottom:10px;color:#f5d16f;font-family:Georgia,serif;font-weight:bold;text-shadow:0 2px 5px #000;opacity:0;transform:scale(.85);transition:.12s;z-index:6;pointer-events:none}#comboBadge.show{opacity:1;transform:scale(1)}
@media(max-width:620px) and (orientation:portrait){
 #actions{grid-template-columns:repeat(3,52px);grid-template-rows:42px 56px}.act{font-size:9px!important}#actions .act{width:52px;height:42px}#actions .primary,#actions .skill{height:56px}
 .titleCard{margin-bottom:1vh;padding:12px}.titleCard h1{font-size:24px}
 .classPanel .cards{grid-template-columns:1fr}.classPanel .card{min-height:100px}
 .invShell{padding:9px}.invTop{grid-template-columns:1fr 1fr}.heroPaper{min-height:190px}.statBox{grid-column:1/3}.itemGrid{grid-template-columns:repeat(4,1fr)}.invBottom{grid-template-columns:1fr}.itemDetail{min-height:auto}
}
@media(max-width:340px) and (orientation:portrait){#actions{grid-template-columns:repeat(3,44px);grid-template-rows:40px 52px}#actions .act{width:44px;height:40px}#actions .primary,#actions .skill{height:52px}.itemGrid{grid-template-columns:repeat(3,1fr)}}

</style>
</head>
<body>
<div id="app"><div id="shell">
  <div id="gameWrap">
    <canvas id="game" width="400" height="240" aria-label="Jogo Crônicas do Ferro"></canvas>
    <canvas id="miniMap" width="100" height="60"></canvas>
    <div id="scan"></div>
    <div id="hud">
      <div class="hudBox"><div id="heroName">—</div><div class="bar"><div id="hpFill" class="fill hp"></div></div><div class="bar"><div id="mpFill" class="fill mp"></div></div><div class="bar"><div id="xpFill" class="fill xp"></div></div></div>
      <div id="hudRight" class="hudBox"><span id="areaName">—</span><br><span id="money">0 ouro</span> · <span id="lvl">Nv. 1</span></div>
    </div>
    <div id="quest">Objetivo: —</div>
    <div id="toast"></div><div id="interactHint">USAR · Interagir</div><div id="comboBadge"></div>
    <div id="overlay"></div>
  </div>
  <div id="mobileInfo" aria-live="polite"><div id="mobileQuest">Objetivo: —</div><div id="mobileStats">Explore, interaja e volte à vila para se preparar.</div></div>
  <div id="controls">
    <div id="dpad">
      <button class="ctrl" id="up" aria-label="Mover para cima">▲</button><button class="ctrl" id="left" aria-label="Mover para a esquerda">◀</button><button class="ctrl" id="down" aria-label="Mover para baixo">▼</button><button class="ctrl" id="right" aria-label="Mover para a direita">▶</button>
    </div>
    <div id="actions">
      <button class="act" id="invBtn" aria-label="Abrir inventário">BOLSA</button><button class="act" id="useBtn" aria-label="Interagir">USAR</button><button class="act dodge" id="dodgeBtn" aria-label="Esquivar">ESQUIVA</button><button class="act skill" id="skillBtn" aria-label="Usar habilidade">HABIL.</button><button class="act primary" id="atkBtn" aria-label="Atacar">ATACAR</button>
    </div>
  </div>
</div></div><div id="sceneSplash"><div class="sceneLabel"><b id="sceneTitle"></b><span id="sceneSub"></span></div></div>
<script>
(() => {
'use strict';
const C=document.getElementById('game'),X=C.getContext('2d'),MM=document.getElementById('miniMap'),MX=MM.getContext('2d');
X.imageSmoothingEnabled=false;MX.imageSmoothingEnabled=false;
const W=400,H=240,T=16, SAVE='cronicas_do_ferro_save_v2', LEGACY_SAVE='cronicas_do_ferro_save_v1';
const $=id=>document.getElementById(id);
const overlay=$('overlay'),toastEl=$('toast');
let keys={},touchKeys={},last=0,toastTimer=0,shake=0,flash=0,gameState='menu',attackId=0,portalLock=0,areaFade=0,walkPhase=0,isMoving=false,sceneTimer=0;
const cloud={user:null,status:'checking',timer:null,pending:null,lastError:''};
const areaArt={village:'data:image/webp;base64,