nt-size:10px}#hudRight{min-width:116px}
 .cards{grid-template-columns:1fr}.panel{padding:14px}.grid{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:340px) and (orientation:portrait){
 #controls{gap:8px}
 #dpad{grid-template:42px 42px 42px/42px 42px 42px;gap:5px}.ctrl{width:42px;height:42px}
 #actions{grid-template-columns:repeat(3,46px);gap:5px}.act{height:46px;font-size:9px}.act.primary{height:54px}
}
@media (orientation:landscape) and (max-height:500px){
 #shell{height:100dvh;justify-content:center;padding:6px}
 #gameWrap{width:min(100%,calc(96dvh * 1.666667));max-width:800px;max-height:none;aspect-ratio:5/3}
 #controls{position:absolute;left:50%;transform:translateX(-50%);bottom:max(5px,env(safe-area-inset-bottom));width:min(100%,calc(96dvh * 1.666667));max-width:800px;padding:0 10px;pointer-events:none}
 #controls button{pointer-events:auto}
 #dpad{grid-template:38px 38px 38px/38px 38px 38px}.ctrl{width:38px;height:38px}
 #actions{grid-template-columns:repeat(3,52px)}.act{height:42px;opacity:.92}.act.primary{height:52px}
 #mobileInfo{display:none}
 #miniMap{top:82px;right:8px;bottom:auto}
}

.authStatus{margin-top:12px;padding:10px 12px;border:1px solid #4c3d27;background:#120f0c;display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap}.authStatus strong{color:#efd68b}.authDot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#7f7462;margin-right:7px}.authDot.online{background:#78a95d;box-shadow:0 0 8px #78a95d88}.field{display:grid;gap:5px;margin:10px 0}.field label{font-size:11px;color:#c9b98f}.field input{width:100%;border:1px solid #6d5632;background:#100d0a;color:#efe2bd;padding:11px 10px;border-radius:4px;font:inherit;outline:none;user-select:text}.field input:focus{border-color:#d8b15c;box-shadow:0 0 0 1px #d8b15c55}.authError{min-height:18px;color:#dc776b;font-size:11px;margin-top:8px}.cloudNote{font-size:10px;color:#9f957e;line-height:1.4}.syncPill{display:inline-block;border:1px solid #4c3d27;padding:3px 7px;font-size:10px;color:#b8aa87;background:#15110d}.syncPill.ok{border-color:#536845;color:#a9c58e}.syncPill.warn{border-color:#7b6035;color:#d6b978}
</style>
</head>
<body>
<div id="app"><div id="shell">
  <div id="gameWrap">
    <canvas id="game" width="400" height="240" aria-label="Jogo Crônicas do Ferro"></canvas>
    <canvas id="miniMap" width="100" height="60"></canvas>
    <div id="scan"></div>
    <div id="hud">
      <div class="hudBox"><div id="heroName">—</div><div class="bar"><div id="hpFill" class="fill hp"></div></div><div class="bar"><div id="mpFill" class="fill mp"></div></div><div class="bar"><div id="xpFill" class="fill xp"></div></div></div>
      <div id="hudRight" class="hudBox"><span id="areaName">—</span><br><span id="money">0 ouro</span> · <span id="lvl">Nv. 1</span></div>
    </div>
    <div id="quest">Objetivo: —</div>
    <div id="toast"></div>
    <div id="overlay"></div>
  </div>
  <div id="mobileInfo" aria-live="polite"><div id="mobileQuest">Objetivo: —</div><div id="mobileStats">Explore, interaja e volte à vila para se preparar.</div></div>
  <div id="controls">
    <div id="dpad">
      <button class="ctrl" id="up" aria-label="Mover para cima">▲</button><button class="ctrl" id="left" aria-label="Mover para a esquerda">◀</button><button class="ctrl" id="down" aria-label="Mover para baixo">▼</button><button class="ctrl" id="right" aria-label="Mover para a direita">▶</button>
    </div>
    <div id="actions">
      <button class="act" id="invBtn" aria-label="Abrir bolsa">BOLSA</button><button class="act" id="useBtn" aria-label="Interagir">USAR</button><button class="act primary" id="atkBtn" aria-label="Atacar">ATACAR</button>
    </div>
  </div>
</div></div>
<script>
(() => {
'use strict';
const C=document.getElementById('game'),X=C.getContext('2d'),MM=document.getElementById('miniMap'),MX=MM.getContext('2d');
X.imageSmoothingEnabled=false;MX.imageSmoothingEnabled=false;
const W=400,H=240,T=16, SAVE='cronicas_do_ferro_save_v2', LEGACY_SAVE='cronicas_do_ferro_save_v1';
const $=id=>document.getElementById(id);
const overlay=$('overlay'),toastEl=$('toast');
let keys={},touchKeys={},last=0,toastTimer=0,shake=0,flash=0,gameState='menu',attackId=0,portalLock=0,areaFade=0,walkPhase=0,isMoving=false;
const rng=(a,b)=>Math.random()*(b-a)+a, clamp=(v,a,b)=>Math.max(a,Math.min(b,v)), dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
const tile=(x,y)=>({x:x*T+T/2,y:y*T+T/2});
const palette={grass:'#5b6c3f',grass2:'#657848',path:'#8a704b',dirt:'#6f573a',tree:'#273d2c',tree2:'#355138',water:'#273f54',stone:'#47443d',wall:'#2d2b2a',floor:'#5b5142',wood:'#68462e',roof:'#4a2923',gold:'#e0b34e',blood:'#a8463f'};
const classes={
 hunter:{name:'Caçador',desc:'Ágil e preciso. Arco, crítico alto e alcance superior.',hp:82,mp:60,damage:13,speed:74,range:105,cool:0.44,armor:0.05,color:'#87b974',skill:'Disparo perfurante',type:'ranged'},
 guardian:{name:'Guardião',desc:'Resistente. Espada larga, dano corpo a corpo e armadura.',hp:125,mp:38,damage:18,speed:60,range:27,cool:0.60,armor:0.22,color:'#c49a6c',skill:'Golpe pesado',type:'melee'},
 occult:{name:'Ocultista',desc:'Frágil, mas poderoso. Projéteis arcanos e muita energia.',hp:72,mp:110,damage:17,speed:68,range:95,cool:0.50,armor:0.02,color:'#9b87c7',skill:'Selo sombrio',type:'magic'}
};
const areaDefs={
 village:{name:'Vila de Cendral',theme:'village',map:[
 '1111111111111111111111111','1000000000000000000000001','1000111100000000111100001','1000111100000000111100001','1000000000000000000000001','1000000000000000000000001','1000000000000000000000001','1000000000000000000000000','1000000000000000000000001','1000011110000111100000001','1000011110000111100000001','1000000000000000000000001','1000000000000000000000001','1000000000000000000000001','1111111111111111111111111']},
 forest:{name:'Floresta de Nargan',theme:'forest',map:[
 '1111111111111111111111111','1111000001110000011110001','1100000001110000000010001','1100110000000000110010001','1000111100000011110010001','1000000000000000000000001','1110001100111001110000001','0000000000000000000000001','1110000110001110000110001','1000000110000000000110001','1001111111000111100000001','1000000000000111100011001','1000111000000000000011001','1000000000000000000000001','1111111111111111111111111']},
 dungeon1:{name:'Cripta do Sino Negro',theme:'dungeon',map:[
 '1111111111111111111111111','1000000010000000000000001','1011111110111111111111101','1010000010000000000000101','1011111111110111111100101','1010000000010