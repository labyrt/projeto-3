 hunter:{name:'Caçador',desc:'Ágil e preciso. Arco, crítico alto e alcance superior.',hp:82,mp:60,damage:13,speed:74,range:105,cool:0.44,armor:0.05,color:'#87b974',skill:'Disparo perfurante',type:'ranged'},
 guardian:{name:'Guardião',desc:'Resistente. Espada larga, dano corpo a corpo e armadura.',hp:125,mp:38,damage:18,speed:60,range:27,cool:0.60,armor:0.22,color:'#c49a6c',skill:'Golpe pesado',type:'melee'},
