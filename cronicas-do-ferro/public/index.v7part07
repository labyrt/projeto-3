"};
(() => {
'use strict';
const $=id=>document.getElementById(id), C=$('game'),X=C.getContext('2d'),M=$('mini'),MX=M.getContext('2d'),overlay=$('overlay');X.imageSmoothingEnabled=false;MX.imageSmoothingEnabled=false;
const W=800,H=450,SAVE='cronicas_do_ferro_save_v7',OLD='cronicas_do_ferro_save_v6',LEGACY='cronicas_do_ferro_save_v2';
const IMG={};let assetsReady=false;function preload(){return Promise.all(Object.entries(ASSET_SRC).map(([k,src])=>new Promise(res=>{const i=new Image();i.onload=()=>{IMG[k]=i;res()};i.onerror=()=>res();i.src=src}))).then(()=>assetsReady=true)}
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),rng=(a,b)=>Math.random()*(b-a)+a,dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y),lerp=(a,b,t)=>a+(b-a)*t;
let keys={},touch={},joyAxis={x:0,y:0},joyPointer=null,attackHeld=false,attackBuffer=0,dodgeBuffer=0,perfectEvadeT=0,hitStop=0,last=0,state='menu',toastTimer=0,sceneTimer=0,shake=0,flash=0,afterimages=[],particles=[],numbers=[],projectiles=[],enemies=[],interactables=[],ambient=[],gameTime=0,wakeLock=null;
const camera={x:W/2,y:H/2,zoom:1.34,targetZoom:1.34,vx:0,vy:0,lookX:0,lookY:0};let cameraSnap=true;

const cloud={user:null,status:'checking',timer:null,pending:null,lastError:''};
function haptic(pattern=10){try{if(navigator.vibrate)navigator.vibrate(pattern)}catch{}}
async function requestWake(){try{if('wakeLock' in navigator&&state==='play'){wakeLock=await navigator.wakeLock.request('screen')}}catch{}}
async function enterImmersive(){
 try{if(!document.fullscreenElement&&document.documentElement.requestFullscreen)await document.documentElement.requestFullscreen({navigationUI:'hide'})}catch{}
 try{if(screen.orientation?.lock)await screen.orientation.lock('landscape')}catch{}
 try{window.scrollTo(0,1)}catch{}
 requestWake();
}
function releaseWake(){try{wakeLock?.release()}catch{}wakeLock=null}

const classes={
 guardian:{name:'Guardião',tag:'Defesa · liderança · impacto',hp:170,mp:75,atk:26,def:.28,speed:150,range:44,cool:.46,skillCd:5.0,color:'#2f6bb2',skill:'Ruptura do Bastião',portrait:'guardian'},
 hunter:{name:'Caçadora',tag:'Agilidade · precisão · liberdade',hp:118,mp:105,atk:19,def:.09,speed:178,range:250,cool:.34,skillCd:4.2,color:'#2f6fb8',skill:'Chuva Perfurante',portrait:'hunter'},
 occult:{name:'Ocultista',tag:'Conhecimento · mistério · poder',hp:102,mp:165,atk:23,def:.06,speed:164,range:225,cool:.42,skillCd:5.5,color:'#3f5f9d',skill:'Selo do Véu',portrait:'occult'}
};
const items={
 guardian_blade:{name:'Espada de Cendral',slot:'weapon',ico:'⚔️',rar:'Comum',atk:6,desc:'Aço equilibrado usado pela guarda da vila.'},oak_shield:{name:'Escudo da Vigia',slot:'shield',ico:'🛡️',rar:'Comum',def:10,desc:'Carvalho e ferro com o selo de Cendral.'},
 hunter_bow:{name:'Arco de Nargan',slot:'weapon',ico:'🏹',rar:'Comum',atk:5,agi:5,desc:'Leve, silencioso e feito para trilhas fechadas.'},occult_staff:{name:'Cajado do Véu',slot:'weapon',ico:'🔮',rar:'Comum',atk:6,desc:'Conduz energia arcana sem ferir o portador.'},
 leather:{name:'Gibão do Peregrino',slot:'armor',ico:'🥋',rar:'Comum',def:6,agi:2,desc:'Couro leve para viagens longas.'},boots:{name:'Botas de Estrada',slot:'boots',ico:'🥾',rar:'Comum',agi:6,desc:'Passos silenciosos e firmes.'},
 moon_ring:{name:'Anel da Lua Baixa',slot:'ring',ico:'💍',rar:'Raro',atk:3,agi:4,desc:'Prata fria encontrada entre raízes antigas.'},juror_helm:{name:'Elmo Jurado',slot:'helm',ico:'🪖',rar:'Raro',def:9,desc:'Proteção dos antigos guardiões da cripta.'},
 forge_charm:{name:'Talismã da Forja',slot:'amulet',ico:'🔥',rar:'Raro',atk:4,def:3,desc:'Metal que ainda guarda o calor do martelo.'},warden:{name:'Lâmina do Abismo',slot:'weapon',ico:'🗡️',rar:'Lendário',atk:17,def:4,desc:'Fragmento de uma arma que resistiu ao vazio.'}
};
function starter(cid){return cid==='guardian'?{weapon:'guardian_blade',shield:'oak_shield',armor:'leather',boots:'boots'}:cid==='hunter'?{weapon:'hunter_bow',armor:'leather',boots:'boots'}:{weapon:'occult_staff',armor:'leather',boots:'boots'}}
const areas={
 village:{name:'Vila de Cendral',art:'village',spawn:[400,330],bounds:{x:70,y:175,w:660,h:235},npcs:[['ilyra',510,305],['smith',250,305],['shop',650,310]],portal:[742,320,'forest'],chest:[150,335,'village_cache']},
 forest:{name:'Bosque de Nargan',art:'forest',spawn:[420,370],bounds:{x:95,y:115,w:625,h:300},portal:[700,132,'dungeon1'],chest:[140,118,'forest_chest']},
 dungeon1:{name:'Ruínas de Eredh',art:'dungeon',spawn:[150,350],bounds:{x:80,y:90,w:650,h:320},obstacles:[{x:352,y:160,w:130,h:120},{x:360,y:318,w:115,h:100}],portal:[675,120,'dungeon2'],chest:[665,205,'dungeon_key'],secret:[145,180]},
 dungeon2:{name:'Abismo do Guardião',art:'boss',spawn:[190,345],bounds:{x:90,y:110,w:620,h:280},portal:[112,340,'dungeon1']}
};
let player=null,progress={quest:0,killsForest:0,key:false,bossDead:false,opened:{},secret:false,weaponUp:0};
function newPlayer(cid){
 const c=classes[cid],eq=starter(cid);
 return{x:areas.village.spawn[0],y:areas.village.spawn[1],vx:0,vy:0,dir:'up',classId:cid,area:'village',hp:c.hp,maxHp:c.hp,mp:c.mp,maxMp:c.mp,atk:c.atk,def:c.def,speed:c.speed,level:1,xp:0,xpNext:60,gold:45,ore:1,potions:3,relics:0,attackCd:0,skillCd:0,dodgeCd:0,invuln:0,attackAnim:0,attackAnimMax:.28,attackKind:'',combo:0,comboT:0,dashT:0,dashSpeed:0,stepFxT:0,inventory:Object.values(eq),equipment:eq};
}
function equipBonus(k){let s=0;for(const id of Object.values(player.equipment||{})){const it=items[id];if(it)s+=it[k]||0}return s}function atkPower(){return player.atk+equipBonus('atk')+progress.weaponUp*3}function moveSpeed(){return player.speed+equipBonus('agi')*.8}function armor(){return clamp(player.def+equipBonus('def')/180,0,.62)}
function questText(){return['Fale com Ilyra na vila','Atravesse o Bosque de Nargan','Derrote 5 monstros no bosque','Encontre a chave antiga nas Ruínas de Eredh','Derrote o Guardião do Abismo','Volte para Ilyra em Cendral','Cendral está segura — continue explorando'][progress.quest]||'Explore o mundo'}
function addItem(id){if(!items[id])return;if(!player.inventory.includes(id)){player.inventory.push(id);toast('Novo equipamento: '+items[id].name)}else{player.gold+=18;toast('Item duplicado convertido em 18 ouro')}}
function buildSave(){return{version:7,savedAt:Date.now(),player,progress}}function validSave(d){return d&&d.player&&classes[d.player.classId]&&areas[d.player.area]}
function localSave(){try{return JSON.parse(localStorage.getItem(SAVE)||localStorage.getItem(OLD)||localStorage.getItem(LEGACY)||'null')}catch{return null}}function saveGame(){if(!player||state==='menu')return;const d=buildSave();try{localStorage.setItem(SAVE,JSON.stringify(d))}catch{}scheduleCloud(d)}
function applySave(d){if(!validSave(d))return false;player={...newPlayer(d.player.classId),...d.player};progress={quest:0,killsForest:0,key:false,bossDead:false,opened:{},secret:false,weaponUp:0,...(d.progress||{})};player.inventory=Array.isArray(player.inventory)?player.inventory:[];player.equipment=player.equipment||starter(player.classId);setupArea(player.area,true);return true}
function migrateOld(){if(localStorage.getItem(SAVE))return;try{const raw=localStorage.getItem(OLD)||localStorage.getItem(LEGACY);if(!raw)return;const d=JSON.parse(raw);if(validSave(d)){d.version=7;d.savedAt=Date.now();localStorage.setItem(SAVE,JSON.stringify(d));return}if(d&&d.player&&classes[d.player.classId]){const p=newPlayer(d.player.classId);Object.assign(p,{level:d.player.level||1,xp:d.player.xp||0,gold:d.player.gold||45,ore:d.player.ore||1,potions:d.player.potions||3,area:d.player.area||'village'});localStorage.setItem(SAVE,JSON.stringify({version:7,savedAt:Date.now(),player:p,progress:{...progress,quest:d.player.quest||0,bossDead:!!d.bossDead}}))}}catch{}}
async function api(path,opt={}){const r=await fetch(path,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(opt.headers||{})},...opt});let b={};try{b=await r.json()}catch{}if(!r.ok)throw new Error(b.error||'Falha na conexão.');return b}
async function initCloud(){try{const r=await api('/api/auth/me');cloud.user=r.user;cloud.status='ok';await reconcileCloud()}catch{cloud.user=null;cloud.status='guest'}}
async function reconcileCloud(){if(!cloud.user)return;try{const r=await api('/api/save'),loc=localSave(),rem=r.data;const lt=Number(loc?.savedAt||0),rt=Number(rem?.savedAt||0);if(validSave(rem)&&rt>lt){localStorage.setItem(SAVE,JSON.stringify(rem))}else if(validSave(loc)&&lt>=rt)await cloudSave(loc);cloud.status='ok'}catch(e){cloud.status='error';cloud.lastError=e.message}}
async function cloudSave(d){if(!cloud.user)return;try{cloud.status='sync';await api('/api/save',{method:'PUT',body:JSON.stringify({data:d})});cloud.status='ok'}catch(e){cloud.status='error';cloud.lastError=e.message}}
function scheduleCloud(d){if(!cloud.user)return;cloud.pending=d;clearTimeout(cloud.timer);cloud.timer=setTimeout(()=>{const x=cloud.pending;cloud.pending=null;cloudSave(x)},800)}
function cloudBadge(){return cloud.user?`<span class="cloudPill"><i class="dot ${cloud.status==='ok'?'ok':''}"></i>${escapeHtml(cloud.user.username)} · ${cloud.status==='sync'?'sincronizando…':cloud.status==='error'?'falha no sync':'nuvem ativa'}</span>`:`<span class="cloudPill"><i class="dot"></i>save local</span>`}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function mainMenu(){state='menu';releaseWake();overlay.className='menuBackdrop';overlay.classList.remove('hidden');overlay.style.backgroundImage=`url(${ASSET_SRC.login})`;const has=validSave(localSave());overlay.innerHTML=`<div class="menuWrap"><div><div class="logo">Crônicas<span>do Ferro</span></div><div class="tagline">Heróis, terras e histórias. Um RPG de exploração, combate e segredos em um mundo medieval vivo.</div></div><div class="cardPanel"><h2>${cloud.user?'Continuar a jornada':'Conta do caçador'}</h2>${cloudBadge()}${cloud.user?`<p>Seu progresso é salvo neste aparelho e sincronizado com a nuvem.</p><div class="menuBtns"><button class="menuBtn primary" id="continue" ${has?'':'disabled'}>CONTINUAR</button><button class="menuBtn" id="new">NOVO JOGO</button><button class="menuBtn" id="logout">SAIR DA CONTA</button></div>`:`<p>Entre para continuar a mesma jornada em outros aparelhos, ou jogue offline.</p><div class="field"><label>Nome de caçador</label><input id="user" maxlength="20" autocomplete="username"></div><div class="field"><label>Senha</label><input id="pass" type="password" maxlength="72" autocomplete="current-password"></div><div class="error" id="authErr"></div><div class="menuBtns"><button class="menuBtn primary" id="login">ENTRAR</button><button class="menuBtn" id="register">CRIAR CONTA</button><button class="menuBtn" id="offline">JOGAR OFFLINE</button>${has?'<button class="menuBtn" id="localCont">CONTINUAR SAVE LOCAL</button>':''}</div>`}</div></div>`;
 if(cloud.user){$('continue').onclick=()=>{if(applySave(localSave()))startPlay()};$('new').onclick=classSelect;$('logout').onclick=async()=>{try{await api('/api/auth/logout',{method:'POST',body:'{}'})}catch{}cloud.user=null;cloud.status='guest';mainMenu()}}
 else{const submit=async mode=>{const u=$('user').value.trim(),p=$('pass').value;$('authErr').textContent='';if(!/^[A-Za-z0-9_.-]{3,20}$/.test(u)){return $('authErr').textContent='Use 3–20 caracteres: letras, números, ponto, _ ou -.'}if(p.length<8)return $('authErr').textContent='A senha precisa ter pelo menos 8 caracteres.';try{const r=await api('/api/auth/'+mode,{method:'POST',body:JSON.stringify({username:u,password:p})});cloud.user=r.user;cloud.status='ok';await reconcileCloud();mainMenu()}catch(e){$('authErr').textContent=e.message}};$('login').onclick=()=>submit('login');$('register').onclick=()=>submit('register');$('offline').onclick=classSelect;if(has)$('localCont').onclick=()=>{applySave(localSave());startPlay()}}
}
function classSelect(){overlay.className='';overlay.style.backgroundImage='none';overlay.innerHTML=`<div class="classWrap"><div class="classHeader"><h2>Escolha sua classe</h2><div class="miniTxt">Cada classe possui ritmo, habilidade e sobrevivência diferentes. Você pode terminar a campanha com qualquer uma.</div></div><div class="classGrid">${Object.entries(classes).map(([id,c])=>`<div class="classCard ${id==='guardian'?'sel':''}" data-c="${id}" style="background-image:url(${ASSET_SRC[c.portrait]})"><div class="classInfo"><h3>${c.name}</h3><div class="miniTxt">${c.tag}</div><p>${id==='guardian'?'Combate próximo, maior defesa e ataques que quebram postura.':id==='hunter'?'Mobilidade alta, ataques à distância e disparos múltiplos.':'Magia de alcance médio, alto dano e controle em área.'}</p><div class="bars"><span>VIDA</span><div class="statLine"><i style="width:${c.hp/1.8}%"></i></div><span>DANO</span><div class="statLine"><i style="width:${c.atk*3}%"></i></div><span>VELOC.</span><div class="statLine"><i style="width:${c.speed/2}%"></i></div></div></div></div>`).join('')}</div><div class="menuBtns" style="max-width:360px;margin:12px auto"><button class="menuBtn primary" id="begin">COMEÇAR A CAÇADA</button><button class="menuBtn" id="back">VOLTAR</button></div></div>`;let sel='guardian';overlay.querySelectorAll('.classCard').forEach(el=>el.onclick=()=>{overlay.querySelectorAll('.classCard').forEach(x=>x.classList.remove('sel'));el.classList.add('sel');sel=el.dataset.c});$('begin').onclick=()=>{player=newPlayer(sel);progress={quest:0,killsForest:0,key:false,bossDead:false,opened:{},secret:false,weaponUp:0};setupArea('village',true);startPlay();saveGame()};$('back').onclick=mainMenu}
function startPlay(){state='play';enterImmersive();overlay.classList.add('hidden');overlay.innerHTML='';updateHud();showScene(player.area)}
function setupArea(id,keep=false){if(!areas[id])id='village';player.area=id;const a=areas[id];if(!keep){player.x=a.spawn[0];player.y=a.spawn[1]}player.vx=player.vy=0;camera.x=player.x;camera.y=player.y;camera.zoom=player.area==='dungeon2'?1.18:1.34;camera.targetZoom=camera.zoom;cameraSnap=true;projectiles=[];enemies=[];interactables=[];particles=[];numbers=[];
 if(a.npcs)for(const n of a.npcs)interactables.push({type:n[0],x:n[1],y:n[2],r:28});if(a.chest)interactables.push({type:'chest',x:a.chest[0],y:a.chest[1],id:a.chest[2],r:26});if(a.secret)interactables.push({type:'secret',x:a.secret[0],y:a.secret[1],r:30});if(a.portal)interactables.push({type:'portal',x:a.portal[0],y:a.portal[1],to:a.portal[2],r:30});if(id==='forest')interactables.push({type:'portal',x:112,y:390,to:'village',r:30});if(id==='dungeon1')interactables.push({type:'portal',x:105,y:350,to:'forest',r:30});
 if(id==='forest'){spawn('wolf',5,[[500,260],[585,305],[635,225],[410,210],[300,330]]);spawn('slime',2,[[350,260],[540,350]])}if(id==='dungeon1')spawn('skeleton',7,[[260,335],[340,300],[430,250],[520,300],[570,190],[380,150],[250,210]]);if(id==='dungeon2'&&!progress.bossDead)enemies.push(makeEnemy('boss',520,245));refreshAmbient();updateBackdrop();saveGame()}
function refreshAmbient(){ambient=[];const n=player.area==='dungeon2'?26:18;for(let i=0;i<n;i++)ambient.push({x:rng(0,W),y:rng(0,H),v:rng(3,12),a:rng(.15,.55),s:rng(1,2.5),phase:rng(0,6.28)})}
function updateBackdrop(){const art=areas[player.area].art;document.getElementById('app').style.backgroundImage=`url(${ASSET_SRC[art]})`}
function showScene(id){const e=$('sceneSplash');e.style.backgroundImage=`url(${ASSET_SRC[areas[id].art]})`;$('sceneTitle').textContent=areas[id].name;$('sceneSub').textContent=id==='village'?'Descanso · comércio · histórias':id==='forest'?'Caça · trilhas · segredos':id==='dungeon1'?'Ruínas · armadilhas · relíquias':'Chefe · sobrevivência · recompensa';e.classList.add('on');clearTimeout(sceneTimer);sceneTimer=setTimeout(()=>e.classList.remove('on'),1000)}
function transition(to){if(player.area==='forest'&&to==='dungeon1'&&progress.killsForest<5){toast(`A trilha ainda está tomada. Derrote ${5-progress.killsForest} monstros.`);return}if(to==='dungeon2'&&!progress.key){toast('A porta antiga exige uma chave.');return}if(player.area==='village'&&to==='forest'&&progress.quest===0){toast('Fale com Ilyra antes de partir.');return}if(progress.quest===1&&to==='forest')progress.quest=2;setupArea(to,false);showScene(to)}
function spawn(type,n,spots){for(let i=0;i<n;i++){const p=spots[i%spots.length];enemies.push(makeEnemy(type,p[0],p[1]))}}
function makeEnemy(type,x,y){const db={wolf:{name:'Lobo sombrio',hp:54,dmg:10,speed:82,range:28,xp:13,gold:[4,10],r:16},slime:{name:'Limo da mata',hp:42,dmg:8,speed:48,range:25,xp:10,gold:[3,8],r:17},skeleton:{name:'Jurado de Eredh',hp:82,dmg:14,speed:62,range:31,xp:20,gold:[7,15],r:17},boss:{name:'Guardião do Abismo',hp:720,dmg:20,speed:48,range:52,xp:220,gold:[150,210],r:38,boss:true}}[type];return{id:Math.random().toString(36).slice(2),type,x,y,vx:0,vy:0,hp:db.hp,maxHp:db.hp,...db,state:'chase',timer:0,windup:0,hit:0,dead:false,phase:1,pattern:1.5}}
function nearestEnemy(max=999){let best=null,bd=max;for(const e of enemies)if(!e.dead){const d=dist(player,e);if(d<bd){bd=d;best=e}}return best}
function aim(){
 const speed=Math.hypot(player.vx,player.vy);
 const face=speed>24?{x:player.vx/speed,y:player.vy/speed}:dirVec(player.dir);
 let best=null,bestScore=1e9;
 for(const e of enemies)if(!e.dead){
   const dx=e.x-player.x,dy=e.y-player.y,d=Math.hypot(dx,dy);
   if(d>310)continue;
   const dot=(dx*face.x+dy*face.y)/(d||1);
   if(dot<-.35&&d>72)continue;
   const score=d*(1.18-dot*.34)-(e.boss?20:0);
   if(score<bestScore){best=e;bestScore=score}
 }
 if(best){
   const dx=best.x-player.x,dy=best.y-player.y,l=Math.hypot(dx,dy)||1;
   return{x:dx/l,y:dy/l,target:best};
 }
 return face;
}function dirVec(d){return d==='left'?{x:-1,y:0}:d==='right'?{x:1,y:0}:d==='up'?{x:0,y:-1}:{x:0,y:1}}
function queueAttack(){
 if(state!=='play')return;
 attackBuffer=.20;
 if(player.attackCd<=0&&player.dashT<=0)attack();
}function attack(){
 if(state!=='play'||player.attackCd>0||player.dashT>0)return;
 attackBuffer=0;haptic(9);
 const c=classes[player.classId];
 player.combo=player.comboT>0?Math.min(3,player.combo+1):1;player.comboT=.82;player.attackKind='basic';
 const step=player.combo-1,d=aim(),p=atkPower();
 player.dir=Math.abs(d.x)>Math.abs(d.y)?(d.x>0?'right':'left'):(d.y>0?'down':'up');

 const cdTable=player.classId==='guardian'?[.82,.74,1]:player.classId==='hunter'?[.80,.72,.90]:[.86,.78,.94];
 const animTable=player.classId==='guardian'?[.24,.22,.30]:player.classId==='hunter'?[.20,.18,.24]:[.24,.22,.28];
 const anim=animTable[step];player.attackCd=c.cool*cdTable[step];player.attackAnimMax=anim;player.attackAnim=anim;

 const lungeTable=player.classId==='guardian'?[6,9,13]:player.classId==='hunter'?[2,3,5]:[1,2,4];
 const lunge=lungeTable[step],ox=player.x,oy=player.y;
 player.x+=d.x*lunge;clampPlayer();if(inObstacle(player.x,player.y))player.x=ox;
 player.y+=d.y*lunge;clampPlayer();if(inObstacle(player.x,player.y))player.y=oy;

 if(player.classId==='guardian'){
   const mult=[.92,1.06,1.48][step],range=[58,64,73][step],minDot=[.08,.04,-.02][step];
   for(const e of enemies)if(!e.dead){
     const ex=e.x-player.x,ey=e.y-player.y,dd=Math.hypot(ex,ey),dot=(ex*d.x+ey*d.y)/(dd||1);
     if(dd<range&&dot>minDot)damageEnemy(e,Math.round(p*mult));
   }
   slashFx(d,player.combo);
 }else{
   const hunter=player.classId==='hunter',mult=hunter?[.90,1,1.24][step]:[.95,1.08,1.35][step],shotSpeed=hunter?400:335;
   projectiles.push({owner:'p',x:player.x+d.x*18,y:player.y+d.y*18,vx:d.x*shotSpeed,vy:d.y*shotSpeed,life:1.14,dmg:Math.round(p*mult),kind:hunter?'arrow':'magic',r:step===2?6:5,pierce:step===2?1:0,hit:new Set(),finisher:step===2});
   burst(player.x+d.x*18,player.y+d.y*18,hunter?'#b7da7a':'#be83ff',step===2?10:6);
 }
 if(player.combo===3){shake=Math.max(shake,2.6);ring(player.x+d.x*20,player.y+d.y*20,28,'#ffe07a')}
}
function skill(){
 if(state!=='play'||player.skillCd>0||player.dashT>0)return;
 haptic([10,18,10]);const c=classes[player.classId],cost=player.classId==='guardian'?20:player.classId==='hunter'?26:34;
 if(player.mp<cost){toast('Energia insuficiente.');return}
 player.mp-=cost;player.skillCd=c.skillCd;player.attackAnimMax=.45;player.attackAnim=.45;player.attackKind='skill';
 if(player.classId==='guardian'){
   for(const e of enemies)if(!e.dead&&dist(player,e)<105){damageEnemy(e,Math.round(atkPower()*1.45));knock(e,player,22)}
   ring(player.x,player.y,110,'#77b9ff');
 }else if(player.classId==='hunter'){
   const d=aim(),base=Math.atan2(d.y,d.x);
   for(let k=-2;k<=2;k++){const a=base+k*.10;projectiles.push({owner:'p',x:player.x,y:player.y,vx:Math.cos(a)*390,vy:Math.sin(a)*390,life:1,dmg:Math.round(atkPower()*.72),kind:'arrow',r:4,pierce:1,hit:new Set()})}
   burst(player.x,player.y,'#99e27d',16);
 }else{
   const e=nearestEnemy(260),tx=e?e.x:player.x+aim().x*120,ty=e?e.y:player.y+aim().y*120;
   ring(tx,ty,90,'#c56fff');
   for(const q of enemies)if(!q.dead&&Math.hypot(q.x-tx,q.y-ty)<90)damageEnemy(q,Math.round(atkPower()*1.55));
   burst(tx,ty,'#d28cff',28);
 }
 toast(c.skill);
}
function dodge(){
 if(state!=='play')return;
 if(player.dodgeCd>0||player.dashT>0){dodgeBuffer=.16;return}
 dodgeBuffer=0;
 const threatened=enemies.some(e=>!e.dead&&e.windup>0&&e.windup<.24&&dist(player,e)<e.range+52)
   ||projectiles.some(p=>p.owner==='e'&&Math.hypot(p.x-player.x,p.y-player.y)<72);
 haptic(threatened?[10,18,10]:12);
 let dx=joyAxis.x+(keys.d||keys.arrowright?1:0)-(keys.a||keys.arrowleft?1:0),dy=joyAxis.y+(keys.s||keys.arrowdown?1:0)-(keys.w||keys.arrowup?1:0);
 if(!dx&&!dy){const d=dirVec(player.dir);dx=d.x;dy=d.y}else{const l=Math.hypot(dx,dy)||1;dx/=l;dy/=l}
 const hunter=player.classId==='hunter';
 player.dashT=hunter?.23:.21;player.dashSpeed=hunter?610:560;player.dashX=dx;player.dashY=dy;
 player.vx=dx*player.dashSpeed;player.vy=dy*player.dashSpeed;player.dodgeCd=hunter?.68:.78;player.invuln=threatened?.46:.34;
 player.attackAnim=0;player.attackKind='';player.attackCd=Math.min(player.attackCd,.12);attackBuffer=0;
 afterimages.push({x:player.x,y:player.y,t:.24,dir:player.dir});
 if(threatened){
   perfectEvadeT=.65;player.mp=Math.min(player.maxMp,player.mp+18);player.dodgeCd*=.5;hitStop=Math.max(hitStop,.045);
   flash=Math.max(flash,.28);shake=Math.max(shake,3);ring(player.x,player.y,42,'#9bdcff');toast('Esquiva perfeita · +18 PM');
 }
}
function hurt(amount){if(player.invuln>0||state!=='play')return;haptic([18,22,14]);const dmg=Math.max(1,Math.round(amount*(1-armor())));player.hp-=dmg;player.invuln=.58;shake=8;flash=.3;numbers.push({x:player.x,y:player.y-28,text:'-'+dmg,c:'#ff8a7b',t:.8});burst(player.x,player.y,'#e65d55',12);if(player.hp<=0)gameOver()}
function damageEnemy(e,dmg){
 if(e.dead)return;
 const finisher=player.combo===3&&player.attackKind==='basic';
 hitStop=Math.max(hitStop,e.boss?(finisher?.042:.030):(finisher?.040:.024));
 const crit=Math.random()<(player.classId==='hunter'?.16:.08);if(crit)dmg=Math.round(dmg*1.55);
 e.hp-=dmg;e.hit=.12;e.stagger=Math.max(e.stagger||0,e.boss?.02:(finisher?.13:.085));
 if(!e.boss)knock(e,player,finisher?10:4);
 if(player.attackKind==='basic')player.mp=Math.min(player.maxMp,player.mp+(player.classId==='hunter'?2.2:1.6));
 shake=Math.max(shake,finisher?3.6:1.4);
 numbers.push({x:e.x,y:e.y-e.r-10,text:(crit?'✦ ':'')+dmg,c:crit?'#ffe181':'#fff0c2',t:.75});
 burst(e.x,e.y,crit?'#ffd76d':'#d7c6a0',crit?11:finisher?9:6);if(finisher)ring(e.x,e.y,30,'#ffe07a');
 if(e.hp<=0)killEnemy(e);
}
function knock(e,from,n){const dx=e.x-from.x,dy=e.y-from.y,l=Math.hypot(dx,dy)||1;e.x+=dx/l*n;e.y+=dy/l*n;clampEntity(e)}
function killEnemy(e){e.dead=true;const g=Math.floor(rng(e.gold[0],e.gold[1]+1));player.gold+=g;gainXp(e.xp);if(Math.random()<.22)player.ore++;if(player.area==='forest'){progress.killsForest++;if(progress.quest===2&&progress.killsForest>=5){progress.quest=3;toast('A trilha para as ruínas foi liberada.')}}if(e.boss){progress.bossDead=true;progress.quest=5;player.relics++;addItem('warden');toast('Guardião derrotado. Volte para Ilyra.');flash=.8;shake=16}saveGame()}
function gainXp(n){player.xp+=n;while(player.xp>=player.xpNext){player.xp-=player.xpNext;player.level++;player.xpNext=Math.round(player.xpNext*1.33);player.maxHp+=12;player.maxMp+=7;player.atk+=2;player.hp=player.maxHp;player.mp=player.maxMp;toast('Nível '+player.level+' — atributos aumentados.')}}
function gameOver(){state='modal';player.hp=0;modal(`<h2>Você caiu na caçada</h2><p class="miniTxt">Ilyra enviou batedores para encontrá-lo. Você retorna a Cendral com parte do ouro perdido.</p><div class="menuBtns"><button class="menuBtn primary" id="respawn">RETORNAR À VILA</button><button class="menuBtn" id="menu">MENU PRINCIPAL</button></div>`);$('respawn').onclick=()=>{player.gold=Math.floor(player.gold*.88);player.hp=player.maxHp;player.mp=player.maxMp;setupArea('village',false);closeModal();state='play';toast('Você perdeu 12% do ouro.')};$('menu').onclick=mainMenu}
function interact(){if(state!=='play')return;const o=nearInteract();if(!o){toast('Nada para interagir aqui.');return}if(o.type==='ilyra')talkIlyra();else if(o.type==='smith')forge();else if(o.type==='shop')shop();else if(o.type==='chest')openChest(o);else if(o.type==='secret')secret(o);else if(o.type==='portal')transition(o.to)}
function nearInteract(){let b=null,bd=999;for(const o of interactables){const d=dist(player,o);if(d<(o.r||28)&&d<bd){bd=d;b=o}}return b}
function talkIlyra(){let t='';if(progress.quest===0){t='As trilhas de Nargan voltaram a sangrar. Cruze o bosque, encontre as ruínas e descubra quem está acordando os mortos.';progress.quest=1}else if(progress.quest===5){t='O sino silenciou. Cendral ganhou outra manhã graças a você. Leve isto — a cidade reconhece seus caçadores.';progress.quest=6;player.gold+=180;addItem('forge_charm')}else t=progress.quest<5?'A estrada ainda chama por você. Prepare-se bem antes de seguir.':'As fronteiras estão quietas por enquanto. Continue explorando.';dialog('Ilyra, Vigia',t);saveGame()}
function dialog(name,text){modal(`<h2>${name}</h2><p>${text}</p><button class="menuBtn primary" id="ok">CONTINUAR</button>`);$('ok').onclick=closeModal}
function shop(){modal(`<h2>Mara, Mercadora</h2><p class="miniTxt">Suprimentos para quem prefere voltar vivo.</p><div class="row"><div><b>Poção de Ervas</b><div class="miniTxt">Recupera 48 PV</div></div><button class="buy" id="bp">18 ouro</button></div><div class="row"><div><b>Anel da Lua Baixa</b><div class="miniTxt">+3 ataque · +4 agilidade</div></div><button class="buy" id="br">85 ouro</button></div><div class="row"><div><b>Minério refinado</b><div class="miniTxt">Usado pelo ferreiro</div></div><button class="buy" id="bo">30 ouro</button></div><p class="miniTxt">Ouro: ${player.gold}</p><button class="menuBtn" id="x">VOLTAR</button>`);$('bp').onclick=()=>buy(18,()=>player.potions++,'Poção adicionada.');$('br').onclick=()=>buy(85,()=>addItem('moon_ring'),'Anel adquirido.');$('bo').onclick=()=>buy(30,()=>player.ore++,'Minério adquirido.');$('x').onclick=closeModal}
function buy(cost,fn,msg){if(player.gold<cost)return toast('Ouro insuficiente.');player.gold-=cost;fn();toast(msg);closeModal();saveGame()}
function forge(){const cost=55+progress.weaponUp*45,ore=1+progress.weaponUp;overlay.style.backgroundImage=`linear-gradient(#02060a77,#02060aee),url(${ASSET_SRC.forge})`;modal(`<h2>Forja de Borin</h2><p>“Uma arma boa não vence a luta. Mas uma arma ruim pode perdê-la.”</p><div class="row"><div><b>Reforçar arma +${progress.weaponUp} → +${progress.weaponUp+1}</b><div class="miniTxt">+3 ataque permanente · requer ${ore} minério</div></div><button class="buy" id="upg">${cost} ouro</button></div><div class="row"><div><b>Talismã da Forja</b><div class="miniTxt">+4 ataque · +3 defesa</div></div><button class="buy" id="charm">110 ouro</button></div><p class="miniTxt">Você possui ${player.gold} ouro e ${player.ore} minério.</p><button class="menuBtn" id="x">VOLTAR</button>`);$('upg').onclick=()=>{if(player.gold<cost||player.ore<ore)return toast('Faltam recursos.');player.gold-=cost;player.ore-=ore;progress.weaponUp++;toast('Arma reforçada.');closeModal();saveGame()};$('charm').onclick=()=>buy(110,()=>addItem('forge_charm'),'Talismã adquirido.');$('x').onclick=closeModal}
function openChest(o){if(progress.opened[o.id])return toast('O baú está vazio.');progress.opened[o.id]=true;if(o.id==='village_cache'){player.gold+=22;player.potions++;toast('22 ouro · 1 poção')}else if(o.id==='forest_chest'){player.gold+=45;addItem('moon_ring');toast('Você encontrou um anel raro.')}else if(o.id==='dungeon_key'){progress.key=true;addItem('juror_helm');player.gold+=65;progress.quest=4;toast('Chave Antiga obtida. A porta do Abismo respondeu.')}burst(o.x,o.y,'#f4c96a',18);saveGame()}
function secret(o){if(progress.secret)return toast('A passagem já está aberta.');progress.secret=true;player.gold+=75;player.ore+=2;addItem('forge_charm');toast('Passagem secreta: 75 ouro · 2 minérios · talismã.');burst(o.x,o.y,'#8bc4ff',22);saveGame()}
function modal(html){state='modal';overlay.className='';overlay.style.backgroundImage='none';overlay.classList.remove('hidden');overlay.innerHTML=`<div class="modal"><button class="close" id="close">×</button>${html}</div>`;const c=$('close');if(c)c.onclick=closeModal}function closeModal(){overlay.classList.add('hidden');overlay.innerHTML='';overlay.style.backgroundImage='none';state='play';updateBackdrop()}
function inventory(tab='equip',selected=null){if(state!=='play'&&state!=='modal')return;state='modal';const inv=player.inventory.filter(id=>items[id]);const sel=selected&&items[selected]?selected:(inv[0]||null),it=sel?items[sel]:null;const eq=player.equipment||{};const slots=['helm','amulet','armor','ring','weapon','shield','boots'];overlay.className='';overlay.style.backgroundImage='none';overlay.classList.remove('hidden');overlay.innerHTML=`<div class="modal" style="width:min(1100px,98vw)"><button class="close" id="close">×</button><h2>Inventário</h2><div class="invGrid"><div class="heroCard" style="background-image:url(${ASSET_SRC[classes[player.classId].portrait]})"><div class="heroMeta"><h3>${classes[player.classId].name}</h3><div class="miniTxt">Nível ${player.level} · Poder ${atkPower()}</div></div></div><div><div class="equipSlots">${slots.map(s=>{const id=eq[s],x=id?items[id]:null;return`<div class="slot"><b>${slotLabel(s)}</b>${x?`<span class="ico">${x.ico}</span><em>${x.name}</em>`:'<em>vazio</em>'}</div>`}).join('')}</div><div class="invTabs"><button class="tab ${tab==='equip'?'on':''}" data-t="equip">Equipamentos</button><button class="tab ${tab==='cons'?'on':''}" data-t="cons">Consumíveis</button><button class="tab ${tab==='mat'?'on':''}" data-t="mat">Materiais</button><button class="tab ${tab==='rel'?'on':''}" data-t="rel">Relíquias</button></div>${tab==='equip'?`<div class="itemGrid">${inv.map(id=>{const x=items[id];return`<button class="item ${sel===id?'sel':''} ${x.rar==='Raro'?'rare':x.rar==='Lendário'?'legend':''}" data-item="${id}"><span class="ico">${x.ico}</span><small>${x.name}</small></button>`}).join('')}</div>`:tab==='cons'?`<div class="row"><b>🧪 Poções de Ervas</b><span>${player.potions}</span></div>`:tab==='mat'?`<div class="row"><b>⛏ Minério</b><span>${player.ore}</span></div><div class="row"><b>🪙 Ouro</b><span>${player.gold}</span></div>`:`<div class="row"><b>💠 Relíquias do Abismo</b><span>${player.relics}</span></div>`}</div><div class="detail">${it?`<div class="bigIco">${it.ico}</div><h3>${it.name}</h3><div class="rarity ${it.rar==='Lendário'?'lg':it.rar==='Raro'?'ep':''}">${it.rar}</div><div class="statTable miniTxt">${it.atk?`Ataque +${it.atk}<br>`:''}${it.def?`Defesa +${it.def}<br>`:''}${it.agi?`Agilidade +${it.agi}<br>`:''}</div><p class="miniTxt">${it.desc}</p><div class="actionBar"><button class="menuBtn primary" id="equip">EQUIPAR</button></div>`:`<h3>Atributos</h3><div class="miniTxt">PV ${Math.ceil(player.hp)}/${player.maxHp}<br>PM ${Math.ceil(player.mp)}/${player.maxMp}<br>Ataque ${atkPower()}<br>Redução de dano ${Math.round(armor()*100)}%<br>Velocidade ${Math.round(moveSpeed())}</div>`}</div></div><div class="actionBar"><button class="menuBtn" id="usePotion">USAR POÇÃO (${player.potions})</button><button class="menuBtn" id="backInv">VOLTAR AO JOGO</button></div></div>`;$('close').onclick=$('backInv').onclick=closeModal;overlay.querySelectorAll('[data-t]').forEach(b=>b.onclick=()=>inventory(b.dataset.t,sel));overlay.querySelectorAll('[data-item]').forEach(b=>b.onclick=()=>inventory('equip',b.dataset.item));if($('equip'))$('equip').onclick=()=>{if(!it)return;player.equipment[it.slot]=sel;toast(it.name+' equipado.');saveGame();inventory('equip',sel)};$('usePotion').onclick=()=>{usePotion();inventory(tab,sel)}}
function slotLabel(s){return{weapon:'Arma',shield:'Escudo',helm:'Elmo',armor:'Armadura',boots:'Botas',ring:'Anel',amulet:'Amuleto'}[s]||s}function contextUse(){if(nearInteract())interact();else usePotion()}function usePotion(){if(player.potions<=0)return toast('Você não possui poções.');if(player.hp>=player.maxHp)return toast('Sua vida já está cheia.');player.potions--;haptic(10);player.hp=Math.min(player.maxHp,player.hp+48);burst(player.x,player.y,'#79d77b',18);toast('+48 PV');saveGame()}
function update(dt){
 if(state!=='play')return;
 gameTime+=dt;attackBuffer=Math.max(0,attackBuffer-dt);dodgeBuffer=Math.max(0,dodgeBuffer-dt);perfectEvadeT=Math.max(0,perfectEvadeT-dt);
 player.attackCd=Math.max(0,player.attackCd-dt);player.skillCd=Math.max(0,player.skillCd-dt);player.dodgeCd=Math.max(0,player.dodgeCd-dt);
 if(dodgeBuffer>0&&player.dodgeCd<=0&&player.dashT<=0)dodge();
 player.invuln=Math.max(0,player.invuln-dt);player.attackAnim=Math.max(0,player.attackAnim-dt);player.comboT=Math.max(0,player.comboT-dt);player.stepFxT=Math.max(0,(player.stepFxT||0)-dt);
 if(player.comboT<=0)player.combo=0;player.mp=Math.min(player.maxMp,player.mp+dt*(player.classId==='occult'?11:7));
 if(attackHeld&&player.attackCd<=0&&player.dashT<=0)queueAttack();if(attackBuffer>0&&player.attackCd<=0&&player.dashT<=0)attack();

 let dx=joyAxis.x+(keys.d||keys.arrowright?1:0)-(keys.a||keys.arrowleft?1:0),dy=joyAxis.y+(keys.s||keys.arrowdown?1:0)-(keys.w||keys.arrowup?1:0);
 let inputMag=Math.min(1,Math.hypot(dx,dy));
 if(inputMag>.12){
   const dead=.12;inputMag=clamp((inputMag-dead)/(1-dead),0,1);const l=Math.hypot(dx,dy)||1;dx/=l;dy/=l;
   if(Math.abs(dx)>Math.abs(dy))player.dir=dx>0?'right':'left';else player.dir=dy>0?'down':'up';
 }else{dx=0;dy=0;inputMag=0}

 if(player.dashT>0){
   player.dashT=Math.max(0,player.dashT-dt);dx=player.dashX;dy=player.dashY;
   const dashSpeed=player.dashSpeed||560;player.vx=dx*dashSpeed;player.vy=dy*dashSpeed;
   if(Math.random()<.72)afterimages.push({x:player.x,y:player.y,t:.18,dir:player.dir});
 }else{
   const attackMove=player.attackAnim>0&&player.attackKind==='basic'?(player.classId==='hunter'?.92:player.classId==='occult'?.80:.62):1;
   const analog=inputMag?Math.max(.22,inputMag):0,targetSpeed=moveSpeed()*analog*attackMove,accel=1-Math.exp(-dt*22);
   player.vx=lerp(player.vx,dx*targetSpeed,accel);player.vy=lerp(player.vy,dy*targetSpeed,accel);
   if(!dx&&!dy){const stop=Math.exp(-dt*28);player.vx*=stop;player.vy*=stop}
 }

 const oldX=player.x,oldY=player.y;
 player.x+=player.vx*dt;clampPlayer();if(inObstacle(player.x,player.y)){player.x=oldX;player.vx=0}
 player.y+=player.vy*dt;clampPlayer();if(inObstacle(player.x,player.y)){player.y=oldY;player.vy=0}

 updateEnemies(dt);updateProjectiles(dt);
 for(const p of particles){p.t-=dt;if(Number.isFinite(p.vx)){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vx*=.97;p.vy*=.97}}
 particles=particles.filter(p=>p.t>0);
 for(const n of numbers){n.t-=dt;n.y-=22*dt}numbers=numbers.filter(n=>n.t>0);
 for(const a of afterimages)a.t-=dt;afterimages=afterimages.filter(a=>a.t>0);
 shake=Math.max(0,shake-dt*18);flash=Math.max(0,flash-dt*2.5);updateCamera(dt);updateHud();updateHint();
}
function updateCamera(dt){
 const base=player.area==='dungeon2'?1.16:(player.area==='dungeon1'?1.26:1.32),nearby=enemies.filter(e=>!e.dead&&dist(player,e)<250),combat=nearby.length>0;
 camera.targetZoom=base-(combat?Math.min(.082,.052+nearby.length*.006):0)+(perfectEvadeT>0?.018:0)+(player.dashT>0?.008:0);
 let lx=clamp(player.vx*.34,-66,66),ly=clamp(player.vy*.22,-36,36);
 if(combat){
   let sx=0,sy=0,w=0;for(const e of nearby){const k=1/Math.max(45,dist(player,e));sx+=e.x*k;sy+=e.y*k;w+=k}
   if(w){lx=clamp(lx+(sx/w-player.x)*.22,-80,80);ly=clamp(ly+(sy/w-player.y)*.16,-44,44)}
 }
 const lf=1-Math.exp(-dt*8.5);camera.lookX=lerp(camera.lookX,lx,lf);camera.lookY=lerp(camera.lookY,ly,lf);
 const tx=player.x+camera.lookX,ty=player.y+camera.lookY;
 if(cameraSnap){camera.x=tx;camera.y=ty;camera.vx=camera.vy=0}else{
   const k=combat?36:30,d=combat?12:11;camera.vx+=(tx-camera.x)*k*dt;camera.vy+=(ty-camera.y)*k*dt;
   const damp=Math.exp(-d*dt);camera.vx*=damp;camera.vy*=damp;camera.x+=camera.vx*dt;camera.y+=camera.vy*dt;
 }
 camera.zoom=lerp(camera.zoom,camera.targetZoom,1-Math.exp(-dt*4.8));
 const vw=W/camera.zoom,vh=H/camera.zoom,cx=clamp(camera.x,vw*.5,W-vw*.5),cy=clamp(camera.y,vh*.5,H-vh*.5);
 if(cx!==camera.x)camera.vx=0;if(cy!==camera.y)camera.vy=0;camera.x=cx;camera.y=cy;cameraSnap=false;
}
function worldTransform(){X.setTransform(camera.zoom,0,0,camera.zoom,W/2-camera.x*camera.zoom,H/2-camera.y*camera.zoom)}
function screenParallax(im,factor,scale=1.10,alpha=1){if(!im)return;const sw=W*scale,sh=H*scale,nx=(camera.x-W/2)/(W/2),ny=(camera.y-H/2)/(H/2);X.save();X.globalAlpha=alpha;X.drawImage(im,(W-sw)/2-nx*34*factor,(H-sh)/2-ny*22*factor,sw,sh);X.restore()}
function inObstacle(x,y){const obs=areas[player.area].obstacles||[];return obs.some(r=>x>r.x&&x<r.x+r.w&&y>r.y&&y<r.y+r.h)}function clampPlayer(){const b=areas[player.area].bounds;player.x=clamp(player.x,b.x,b.x+b.w);player.y=clamp(player.y,b.y,b.y+b.h)}function clampEntity(e){const b=areas[player.area].bounds;e.x=clamp(e.x,b.x,b.x+b.w);e.y=clamp(e.y,b.y,b.y+b.h)}
function updateEnemies(dt){
 for(const e of enemies){
   if(e.dead)continue;e.hit=Math.max(0,e.hit-dt);e.stagger=Math.max(0,(e.stagger||0)-dt);
   if(e.boss){updateBoss(e,dt);continue}
   const d=dist(player,e);
   if(e.windup>0){
     e.vx*=Math.exp(-dt*18);e.vy*=Math.exp(-dt*18);e.windup-=dt;
     if(e.windup<=0){if(dist(player,e)<e.range+18)hurt(e.dmg);e.timer=1.0;burst(e.x,e.y,'#ffb36b',7)}
     continue;
   }
   if(e.stagger>0){e.vx*=Math.exp(-dt*24);e.vy*=Math.exp(-dt*24);continue}
   e.timer=Math.max(0,e.timer-dt);
   if(d>e.range){
     const dx=(player.x-e.x)/(d||1),dy=(player.y-e.y)/(d||1),a=1-Math.exp(-dt*7);
     e.vx=lerp(e.vx,dx*e.speed,a);e.vy=lerp(e.vy,dy*e.speed,a);e.x+=e.vx*dt;e.y+=e.vy*dt;clampEntity(e);
   }else{
     e.vx*=Math.exp(-dt*12);e.vy*=Math.exp(-dt*12);
     if(e.timer<=0)e.windup=e.type==='wolf'?.32:.43;
   }
 }
}
function updateBoss(e,dt){const d=dist(player,e);e.pattern-=dt;if(e.windup>0){e.windup-=dt;if(e.windup<=0){bossExecute(e)}return}if(e.pattern<=0){e.phase=e.hp/e.maxHp<.5?2:1;const roll=Math.random();e.next=roll<.38?'burst':roll<.72?'slam':'charge';e.windup=e.next==='burst'?.75:e.next==='slam'?.62:.48;e.pattern=e.phase===2?1.7:2.2;return}if(d>85&&e.next!=='charge'){const dx=(player.x-e.x)/(d||1),dy=(player.y-e.y)/(d||1);e.x+=dx*e.speed*dt*(e.phase===2?1.2:1);e.y+=dy*e.speed*dt*(e.phase===2?1.2:1);clampEntity(e)}}
function bossExecute(e){if(e.next==='burst'){const n=e.phase===2?12:9;for(let i=0;i<n;i++){const a=i/n*Math.PI*2+gameTime*.3;projectiles.push({owner:'e',x:e.x,y:e.y,vx:Math.cos(a)*150,vy:Math.sin(a)*150,life:2.2,dmg:e.dmg,kind:'void',r:7})}ring(e.x,e.y,120,'#a95cff')}else if(e.next==='slam'){ring(e.x,e.y,95,'#ff7558');if(dist(player,e)<100)hurt(e.dmg+4)}else{const dx=(player.x-e.x)/(dist(player,e)||1),dy=(player.y-e.y)/(dist(player,e)||1);e.x+=dx*105;e.y+=dy*105;clampEntity(e);if(dist(player,e)<72)hurt(e.dmg+7);shake=10}burst(e.x,e.y,'#bf69ff',20)}
function updateProjectiles(dt){for(const p of projectiles){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;if(p.owner==='p'){for(const e of enemies)if(!e.dead&&!p.hit.has(e.id)&&Math.hypot(p.x-e.x,p.y-e.y)<e.r+p.r){p.hit.add(e.id);damageEnemy(e,p.dmg);if(p.pierce>0)p.pierce--;else p.life=0}}else if(Math.hypot(p.x-player.x,p.y-player.y)<18+p.r){hurt(p.dmg);p.life=0}if(p.x<20||p.x>780||p.y<30||p.y>430)p.life=0}projectiles=projectiles.filter(p=>p.life>0)}
function burst(x,y,c,n=10){for(let i=0;i<n;i++)particles.push({x,y,vx:rng(-80,80),vy:rng(-80,20),t:rng(.25,.65),max:.65,c,s:rng(2,5)})}function ring(x,y,r,c){particles.push({ring:true,x,y,r:6,to:r,t:.55,max:.55,c,s:2})}function slashFx(d,combo){particles.push({slash:true,x:player.x,y:player.y,ang:Math.atan2(d.y,d.x),t:.24,max:.24,c:combo===3?'#ffe07a':'#9bd5ff',s:combo})}
function draw(){
 const ox=shake?rng(-shake,shake):0,oy=shake?rng(-shake,shake):0;
 X.setTransform(1,0,0,1,0,0);X.clearRect(0,0,W,H);X.save();X.translate(ox,oy);drawBackground();X.restore();
 X.save();X.translate(ox,oy);worldTransform();drawAmbient();drawInteractables();
 for(const a of afterimages){X.globalAlpha=(a.t/.24)*.22;drawHero(a.x,a.y,a.dir,true);X.globalAlpha=1}
 const list=[];for(const e of enemies)if(!e.dead)list.push({y:e.y,fn:()=>drawEnemy(e)});list.push({y:player.y,fn:()=>drawHero(player.x,player.y,player.dir,false)});list.sort((a,b)=>a.y-b.y);list.forEach(r=>r.fn());drawProjectiles();drawFx();X.restore();
 drawForeground();if(flash>0){X.fillStyle=`rgba(255,244,215,${flash*.22})`;X.fillRect(0,0,W,H)}drawMini()
}
function drawBackground(){const im=IMG[areas[player.area].art];if(!im){X.fillStyle='#18202a';X.fillRect(0,0,W,H);return}
 screenParallax(im,.20,1.05,1);X.fillStyle='rgba(2,6,12,.08)';X.fillRect(0,0,W,H);
 X.save();worldTransform();X.globalAlpha=.96;X.drawImage(im,0,0,W,H);X.restore();
 const haze=player.area==='forest'?'rgba(92,130,166,.08)':player.area==='dungeon2'?'rgba(104,45,150,.10)':'rgba(255,186,92,.035)';X.fillStyle=haze;X.fillRect(0,0,W,H)
}
function drawForeground(){
 const drift=(camera.x-W/2)*.16, bob=Math.sin(gameTime*.7)*3;X.save();X.globalAlpha=.22;
 X.fillStyle=player.area.startsWith('dungeon')?'#160e22':'#07150f';
 X.beginPath();X.ellipse(-28-drift*.25,H*.76+bob,110,170,-.35,0,Math.PI*2);X.fill();
 X.beginPath();X.ellipse(W+34-drift*.18,H*.70-bob,125,185,.28,0,Math.PI*2);X.fill();
 X.globalAlpha=.08;X.fillStyle='#eacb79';for(let i=0;i<7;i++){const x=(i*139+gameTime*7)%W,y=40+((i*71)%340);X.fillRect(x,y,2,2)}X.restore();
}
function drawAmbient(){for(const a of ambient){const y=(a.y-gameTime*a.v)%H;X.globalAlpha=a.a*(.5+.5*Math.sin(gameTime*2+a.phase));X.fillStyle=player.area.startsWith('dungeon')?'#ffad55':player.area==='forest'?'#c8e98d':'#ffd889';X.fillRect(a.x,y<0?y+H:y,a.s,a.s);X.globalAlpha=1}}
function drawInteractables(){for(const o of interactables){if(o.type==='portal'){X.globalAlpha=.45+.25*Math.sin(gameTime*4);X.strokeStyle=player.area==='forest'?'#9ddf8e':'#71b7ff';X.lineWidth=2;X.beginPath();X.arc(o.x,o.y,18,0,Math.PI*2);X.stroke();X.globalAlpha=1}else if(o.type==='chest'&&!progress.opened[o.id])drawChest(o.x,o.y);else if(['ilyra','smith','shop'].includes(o.type))drawNpc(o)}if(progress.secret&&player.area==='dungeon1'){X.fillStyle='#69b6ff88';X.fillRect(125,165,40,4)}}
function drawNpc(o){const bob=Math.sin(gameTime*3+o.x)*1.5;X.save();X.translate(o.x,o.y+bob);if(o.type==='ilyra'){pxRect(-7,-22,14,18,'#e9e3cf');pxRect(-6,-26,12,8,'#d9c7a4');pxRect(-8,-15,16,12,'#456da0');pxRect(-9,-4,18,8,'#e4dfcf')}else if(o.type==='smith'){pxRect(-9,-20,18,18,'#7b3b26');pxRect(-7,-26,14,9,'#d66e3a');pxRect(-11,-6,22,10,'#5b3827');pxRect(9,-13,4,18,'#6d6b67')}else{pxRect(-8,-20,16,19,'#8e3f4d');pxRect(-6,-26,12,8,'#b56a49');pxRect(-10,-5,20,9,'#e8d5b5')}X.restore();if(dist(player,o)<45){X.fillStyle='#f6d779';X.font='bold 17px Georgia';X.textAlign='center';X.fillText('!',o.x,o.y-35)}}
function drawChest(x,y){X.save();X.translate(x,y);pxRect(-12,-7,24,14,'#6f3d20');pxRect(-12,-2,24,4,'#d1a03f');pxRect(-2,-6,4,12,'#d1a03f');pxRect(-10,-9,20,4,'#8a5229');X.restore()}
function pxRect(x,y,w,h,c){X.fillStyle=c;X.fillRect(Math.round(x),Math.round(y),Math.round(w),Math.round(h))}
function drawHero(x,y,dir,ghost){
 const c=player.classId,speed=Math.hypot(player.vx,player.vy),moving=speed>8;
 const walk=Math.sin(gameTime*(11+Math.min(5,speed/80)))*2*(moving?1:0),idle=Math.sin(gameTime*3.2)*.7;
 const animMax=player.attackAnimMax||.28,attack=player.attackAnim>0?clamp(1-player.attackAnim/animMax,0,1):0,strike=player.attackAnim>0?Math.sin(attack*Math.PI):0,dv=dirVec(dir);
 X.save();X.translate(Math.round(x+dv.x*strike*3.5),Math.round(y+idle+dv.y*strike*2.5));
 const lean=clamp(player.vx/650,-.045,.045);X.rotate(dir==='left'?-lean:lean);if(dir==='left')X.scale(-1,1);
 const squash=player.dashT>0?.07:(moving?Math.min(.025,speed/9000):0);X.scale(1.18*(1+squash),1.18*(1-squash*.6));
 const hit=player.invuln>0&&Math.floor(gameTime*20)%2===0;if(hit&&!ghost)X.globalAlpha=.45;
 X.fillStyle='#0007';X.beginPath();X.ellipse(0,10,14,5,0,0,Math.PI*2);X.fill();
 if(c==='guardian')drawGuardian(walk,attack,dir);else if(c==='hunter')drawHunter(walk,attack,dir);else drawOccult(walk,attack,dir);X.restore();
}
function cloak(c1,c2,w,back=false){const sway=Math.sin(gameTime*8)*1.5+w*.7;X.fillStyle=c1;X.beginPath();X.moveTo(-9,-17);X.lineTo(-13-sway,5);X.lineTo(0,12);X.lineTo(13+sway,5);X.lineTo(9,-17);X.closePath();X.fill();X.fillStyle=c2;X.fillRect(-2,-15,4,22);if(back){X.fillStyle='#d7ad48';X.fillRect(-1,-12,2,13)}}
function drawGuardian(w,a,dir){const back=dir==='up';cloak('#173d79','#d5a842',w,back);pxRect(-9,0,7,11,'#18243a');pxRect(2,0,7,11,'#18243a');pxRect(-10+w,-1,7,5,'#b7c4cc');pxRect(3-w,-1,7,5,'#b7c4cc');pxRect(-11,-15,22,17,'#c4cdd1');pxRect(-8,-12,16,12,'#235a9b');pxRect(-8,-25,16,12,'#d7b08b');pxRect(-10,-29,20,7,'#242b39');pxRect(-10,-24,4,5,'#303a48');X.fillStyle='#184b8a';X.beginPath();X.moveTo(-12,-14);X.lineTo(-22,-5);X.lineTo(-18,10);X.lineTo(-8,3);X.closePath();X.fill();X.strokeStyle='#e2bd55';X.lineWidth=1.5;X.stroke();X.save();X.translate(11,-8);X.rotate(a?(-.7+a*1.9):.12);X.fillStyle='#f2f4f2';X.fillRect(0,-2,31,4);X.fillStyle='#e3bd57';X.fillRect(-4,-3,8,6);X.restore()}
function drawHunter(w,a,dir){const back=dir==='up';cloak('#102f67','#d7ad48',w,back);pxRect(-7,-1,5,11,'#202738');pxRect(2,-1,5,11,'#202738');pxRect(-9,-16,18,17,'#173d79');pxRect(-8,-24,16,11,'#ddb995');X.fillStyle='#0f2f66';X.beginPath();X.moveTo(-12,-26);X.lineTo(0,-35);X.lineTo(12,-26);X.lineTo(8,-19);X.lineTo(-8,-19);X.closePath();X.fill();pxRect(-11,-30,4,8,'#d6ad47');pxRect(8,-31,4,10,'#d6ad47');X.save();X.translate(13,-9);X.rotate(a?(-.45+a*.95):0);X.strokeStyle='#dfb451';X.lineWidth=2;X.beginPath();X.arc(0,0,13,-1.2,1.2);X.stroke();X.strokeStyle='#a9d9ff';X.beginPath();X.moveTo(4,-11);X.lineTo(4,11);X.stroke();X.fillStyle='#bde8ff';X.fillRect(2,-1,23,2);X.restore()}
function drawOccult(w,a,dir){const back=dir==='up';cloak('#142d66','#d7ad48',w,back);pxRect(-7,-1,5,11,'#1d2140');pxRect(2,-1,5,11,'#1d2140');pxRect(-9,-16,18,17,'#173d79');pxRect(-8,-24,16,11,'#dfbd9f');X.fillStyle='#102a5f';X.beginPath();X.moveTo(-13,-25);X.lineTo(0,-36);X.lineTo(13,-25);X.lineTo(8,-17);X.lineTo(-8,-17);X.closePath();X.fill();pxRect(-9,-23,18,3,'#d4a94b');X.save();X.translate(12,-8);X.rotate(a?(-.35+a*.8):.02);pxRect(-1,-7,3,30,'#8b633b');X.fillStyle='#8f4fd5';X.beginPath();X.arc(0,-10,6+Math.sin(gameTime*5),0,Math.PI*2);X.fill();X.fillStyle='#e0b7ff';X.fillRect(-2,-12,4,4);X.restore();if(player.attackKind==='skill'&&player.attackAnim>0){X.globalAlpha=.5;X.strokeStyle='#a968ff';X.lineWidth=2;X.beginPath();X.arc(0,5,18+Math.sin(gameTime*12)*3,0,Math.PI*2);X.stroke();X.globalAlpha=1}}
function drawEnemy(e){X.save();const moving=Math.hypot(e.vx||0,e.vy||0)>5||(!e.boss&&dist(player,e)>e.range&&e.windup<=0),stride=moving?Math.sin(gameTime*(e.type==='wolf'?13:e.type==='slime'?8:10)+e.x*.035):0,bob=(moving?Math.abs(stride)*1.8:Math.sin(gameTime*3+e.x)*.65);X.translate(Math.round(e.x),Math.round(e.y+bob));if(moving&&!e.boss){X.rotate(stride*(e.type==='wolf'?.025:.012));X.scale(1+Math.abs(stride)*.025,1-Math.abs(stride)*.035)}if(e.windup>0){const charge=1-clamp(e.windup/(e.boss?(e.next==='burst'?.75:e.next==='slam'?.62:.48):(e.type==='wolf'?.32:.43)),0,1),pulse=.5+.5*Math.sin(gameTime*18);X.strokeStyle=e.boss?'#cf66ff':'#ffb064';X.globalAlpha=.48+.4*pulse;X.lineWidth=2.5+charge*2;X.beginPath();X.arc(0,0,e.r+10+charge*8,0,Math.PI*2);X.stroke();X.globalAlpha=.12+.16*charge;X.fillStyle=e.boss?'#cf66ff':'#ff8b55';X.beginPath();X.arc(0,0,e.r+5+charge*5,0,Math.PI*2);X.fill();X.globalAlpha=1;X.scale(1+charge*.07,1-charge*.05)}if(e.hit>0){X.filter='brightness(1.9)';X.translate(rng(-1.5,1.5),rng(-1,1))}if(e.type==='wolf'){X.fillStyle='#242b31';X.beginPath();X.moveTo(-19,4);X.lineTo(-13,-8);X.lineTo(5,-9);X.lineTo(18,-3);X.lineTo(14,8);X.lineTo(-12,9);X.fill();pxRect(6,-11,12,11,'#343a40');pxRect(10,-15,4,6,'#343a40');pxRect(16,-14,4,7,'#343a40');pxRect(14,-7,2,2,'#e95a4d');pxRect(-12,7,4,9,'#1d2328');pxRect(6,6,4,10,'#1d2328')}else if(e.type==='slime'){X.fillStyle='#4f7d57';X.beginPath();X.ellipse(0,2,18,14,0,0,Math.PI*2);X.fill();pxRect(-7,-5,14,8,'#6ca469');pxRect(-6,0,3,3,'#111');pxRect(4,0,3,3,'#111')}else if(e.type==='skeleton'){pxRect(-5,-13,10,16,'#d9cfb1');pxRect(-7,-24,14,12,'#e5dcc1');pxRect(-5,-21,3,3,'#e14f48');pxRect(2,-21,3,3,'#e14f48');pxRect(-10,3,6,13,'#b8ad93');pxRect(4,3,6,13,'#b8ad93');X.strokeStyle='#9c7a48';X.lineWidth=3;X.strokeRect(-18,-11,10,15);pxRect(10,-12,3,27,'#b9bdc2')}else drawBoss(e);X.filter='none';if(e.hp<e.maxHp){X.fillStyle='#170b0b';X.fillRect(-e.r,-e.r-18,e.r*2,6);X.fillStyle=e.boss?'#a254c6':'#d84e49';X.fillRect(-e.r,-e.r-18,e.r*2*e.hp/e.maxHp,6)}X.restore()}
function drawBoss(e){const breathe=Math.sin(gameTime*2.8)*.018,enraged=e.phase===2;X.save();X.scale(1+breathe,1-breathe*.7);X.globalAlpha=enraged?.58:.45;X.fillStyle=enraged?'#b14ee0':'#8d40c7';X.beginPath();X.arc(0,0,48+Math.sin(gameTime*3)*4+(enraged?4:0),0,Math.PI*2);X.fill();X.globalAlpha=1;pxRect(-29,-31,58,49,'#19161e');pxRect(-24,-36,48,18,'#30263a');pxRect(-34,-24,12,36,'#5b4666');pxRect(22,-24,12,36,'#5b4666');pxRect(-24,12,18,25,'#17141b');pxRect(6,12,18,25,'#17141b');X.fillStyle='#7e3ab2';X.beginPath();X.arc(0,-10,10+Math.sin(gameTime*5)*2,0,Math.PI*2);X.fill();X.fillStyle='#df98ff';X.fillRect(-3,-13,6,6);X.fillStyle='#24172f';X.beginPath();X.moveTo(-20,-36);X.lineTo(-38,-55);X.lineTo(-8,-39);X.fill();X.beginPath();X.moveTo(20,-36);X.lineTo(38,-55);X.lineTo(8,-39);X.fill();X.restore()}
function drawProjectiles(){for(const p of projectiles){X.save();X.translate(p.x,p.y);if(p.kind==='arrow'){X.fillStyle='#f0d59d';X.fillRect(-7,-1,14,2);X.fillStyle='#77bd68';X.fillRect(-7,-3,3,2)}else{X.fillStyle=p.kind==='void'?'#8d46c7':'#bb70ef';X.beginPath();X.arc(0,0,p.r,0,Math.PI*2);X.fill();X.fillStyle='#f3c8ff';X.fillRect(-2,-2,4,4)}X.restore()}}
function drawFx(){for(const p of particles){const a=clamp(p.t/p.max,0,1);X.globalAlpha=a;if(p.ring){const q=1-a;X.strokeStyle=p.c;X.lineWidth=3;X.beginPath();X.arc(p.x,p.y,lerp(p.r,p.to,q),0,Math.PI*2);X.stroke()}else if(p.slash){X.strokeStyle=p.c;X.lineWidth=5;X.beginPath();X.arc(p.x,p.y,40+p.s*4,p.ang-1.05,p.ang+1.05);X.stroke()}else{X.fillStyle=p.c;X.fillRect(p.x,p.y,p.s,p.s)}X.globalAlpha=1}for(const n of numbers){X.globalAlpha=clamp(n.t/.75,0,1);X.fillStyle=n.c;X.font='bold 16px ui-monospace,monospace';X.textAlign='center';X.fillText(n.text,n.x,n.y);X.globalAlpha=1}}
function drawMini(){MX.clearRect(0,0,M.width,M.height);MX.fillStyle='#07111bdd';MX.fillRect(0,0,M.width,M.height);MX.strokeStyle='#7a633b';MX.strokeRect(1,1,M.width-2,M.height-2);const b=areas[player.area].bounds,sx=(M.width-16)/b.w,sy=(M.height-14)/b.h;MX.fillStyle='#365447';MX.fillRect(8,7,b.w*sx,b.h*sy);for(const o of interactables){MX.fillStyle=o.type==='portal'?'#6cc3ff':o.type==='chest'&&!progress.opened[o.id]?'#e5bb52':['ilyra','shop','smith'].includes(o.type)?'#d3d7e3':'#7a85a0';MX.fillRect(8+(o.x-b.x)*sx-2,7+(o.y-b.y)*sy-2,4,4)}for(const e of enemies)if(!e.dead){MX.fillStyle=e.boss?'#d151c9':'#c74d48';MX.fillRect(8+(e.x-b.x)*sx-1,7+(e.y-b.y)*sy-1,3,3)}MX.fillStyle='#fff0b2';MX.beginPath();MX.moveTo(8+(player.x-b.x)*sx,4+(player.y-b.y)*sy);MX.lineTo(4+(player.x-b.x)*sx,12+(player.y-b.y)*sy);MX.lineTo(12+(player.x-b.x)*sx,12+(player.y-b.y)*sy);MX.fill()}
function updateHud(){if(!player)return;const c=classes[player.classId];$('portrait').style.backgroundImage=`url(${ASSET_SRC[c.portrait]})`;$('heroLine').textContent=`${c.name} · Poder ${atkPower()}`;$('hpBar').style.width=(100*player.hp/player.maxHp)+'%';$('mpBar').style.width=(100*player.mp/player.maxMp)+'%';$('xpBar').style.width=(100*player.xp/player.xpNext)+'%';$('hpTxt').textContent=`${Math.ceil(player.hp)}/${player.maxHp}`;$('mpTxt').textContent=`${Math.ceil(player.mp)}/${player.maxMp}`;$('xpTxt').textContent=`${player.xp}/${player.xpNext}`;$('areaName').textContent=areas[player.area].name;$('goldTxt').textContent=player.gold+' ouro';$('levelTxt').textContent='Nv. '+player.level;$('objective').textContent='Objetivo: '+questText();$('skillCool').textContent=player.skillCd>0?player.skillCd.toFixed(1):'';$('dodgeCool').textContent=player.dodgeCd>0?player.dodgeCd.toFixed(1):'';const cb=$('combo');if(player.combo>1&&player.comboT>0){cb.textContent='COMBO ×'+player.combo;cb.classList.add('comboOn')}else cb.classList.remove('comboOn')}
function updateHint(){const o=nearInteract(),h=$('hint');if(o){h.textContent=o.type==='portal'?'USAR · Viajar':o.type==='chest'?'USAR · Abrir baú':o.type==='secret'?'USAR · Examinar parede':'USAR · Conversar';h.classList.add('hintOn')}else h.classList.remove('hintOn')}
function toast(t){const el=$('toast');el.textContent=t;el.classList.add('showToast');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('showToast'),1800)}
function loop(t){const dt=Math.min(.033,(t-last)/1000||0);last=t;if(hitStop>0&&state==='play'){hitStop=Math.max(0,hitStop-dt);if(player)draw();requestAnimationFrame(loop);return}update(dt);if(player)draw();requestAnimationFrame(loop)}
window.addEventListener('keydown',e=>{const k=e.key.toLowerCase();keys[k]=true;if([' ','arrowup','arrowdown','arrowleft','arrowright','shift'].includes(k))e.preventDefault();if(k===' ')queueAttack();if(k==='q')skill();if(k==='shift')dodge();if(k==='e')interact();if(k==='i')inventory();if(k==='escape'&&state==='modal')closeModal()});window.addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);window.addEventListener('blur',()=>{keys={};touch={}});document.addEventListener('visibilitychange',()=>{if(document.hidden){saveGame();keys={};touch={};attackHeld=false;releaseWake()}else if(state==='play')requestWake()});
function bindJoystick(){const joy=$('joystick'),knob=$('joyKnob');if(!joy||!knob)return;const reset=()=>{joyAxis.x=0;joyAxis.y=0;joyPointer=null;knob.style.transform='translate(0px,0px)'};const move=e=>{if(joyPointer!==e.pointerId)return;const r=joy.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2,max=r.width*.34;let dx=e.clientX-cx,dy=e.clientY-cy,d=Math.hypot(dx,dy);if(d>max){dx*=max/d;dy*=max/d}const rawX=dx/max,rawY=dy/max,mag=Math.hypot(rawX,rawY),dead=.12;if(mag<=dead){joyAxis.x=0;joyAxis.y=0}else{const scaled=(mag-dead)/(1-dead),n=mag||1;joyAxis.x=rawX/n*scaled;joyAxis.y=rawY/n*scaled}knob.style.transform=`translate(${dx}px,${dy}px)`};joy.addEventListener('pointerdown',e=>{e.preventDefault();joyPointer=e.pointerId;joy.setPointerCapture?.(e.pointerId);move(e)});joy.addEventListener('pointermove',move);['pointerup','pointercancel','lostpointercapture'].forEach(ev=>joy.addEventListener(ev,e=>{if(joyPointer===e.pointerId)reset()}));}
bindJoystick();
$('atkBtn').onpointerdown=e=>{e.preventDefault();attackHeld=true;queueAttack();haptic(5)};$('atkBtn').onpointerup=$('atkBtn').onpointercancel=$('atkBtn').onpointerleave=()=>attackHeld=false;
$('skillBtn').onpointerdown=e=>{e.preventDefault();skill()};$('dodgeBtn').onpointerdown=e=>{e.preventDefault();dodge()};$('useBtn').onpointerdown=e=>{e.preventDefault();contextUse()};$('invBtn').onpointerdown=e=>{e.preventDefault();haptic(6);inventory()};
document.addEventListener('contextmenu',e=>e.preventDefault());
setInterval(()=>{if(state==='play')saveGame()},9000);if('serviceWorker' in navigator&&location.protocol!=='file:')navigator.serviceWorker.register('./sw.js').catch(()=>{});migrateOld();preload().then(()=>initCloud()).finally(()=>{mainMenu();requestAnimationFrame(loop)});
})();
</script>
</body>
</html>