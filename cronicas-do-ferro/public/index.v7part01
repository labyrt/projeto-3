<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#07101a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="screen-orientation" content="landscape">
<title>Crônicas do Ferro</title>
<style>
:root{--ink:#f1e2b8;--muted:#b8aa8a;--gold:#d8ac4e;--gold2:#8e6828;--blue:#164a85;--blue2:#0c2b52;--panel:#07111dec;--panel2:#0e1722f2;--red:#d9504c;--green:#75b26d;--purple:#9f63d9;--line:#6f5429;--shadow:#02050a}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#02060a;color:var(--ink);font-family:Georgia,"Times New Roman",serif;touch-action:none;overscroll-behavior:none}
button,input{font:inherit}button{color:inherit}input{user-select:text}
#app{height:100dvh;display:flex;align-items:center;justify-content:center;background:#02060a center/cover no-repeat;position:relative;isolation:isolate}
#app:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 30%,#17324e44,#02060ae9 72%);z-index:-1}
#shell{width:min(100vw,1100px);height:min(100dvh,740px);display:flex;flex-direction:column;justify-content:center;gap:8px;padding:max(6px,env(safe-area-inset-top)) max(6px,env(safe-area-inset-right)) max(6px,env(safe-area-inset-bottom)) max(6px,env(safe-area-inset-left))}
#gameFrame{position:relative;width:100%;aspect-ratio:16/9;max-height:calc(100dvh - 112px);margin:auto;border:2px solid var(--gold2);background:#05080b;overflow:hidden;box-shadow:0 0 0 2px #111a24,0 14px 40px #000b}
#gameFrame:after{content:"";position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 40px #0009,inset 0 0 0 1px #e6c36a22}
canvas{display:block;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges}
#game{background:#0b1015}
#scan{position:absolute;inset:0;pointer-events:none;opacity:.28;background:repeating-linear-gradient(0deg,#0000 0 3px,#0002 4px);mix-blend-mode:multiply}
#hud{position:absolute;inset:10px 10px auto 10px;display:flex;justify-content:space-between;gap:10px;pointer-events:none;text-shadow:0 2px 2px #000;z-index:8}
.hudPanel{background:linear-gradient(180deg,#07101ee8,#0a1118e8);border:1px solid var(--gold);box-shadow:inset 0 0 0 1px #000,0 3px 10px #0007;border-radius:6px;padding:7px 9px}
#heroHud{display:grid;grid-template-columns:50px 190px;gap:8px;align-items:center;min-width:258px}
#portrait{width:50px;height:50px;border:1px solid var(--gold);background:#132032 center 17%/cover no-repeat;box-shadow:inset 0 0 0 2px #09111c}
#heroLine{font-weight:700;font-size:15px;letter-spacing:.03em}.hudStat{display:grid;grid-template-columns:24px 1fr 60px;align-items:center;gap:5px;font-size:10px;margin-top:3px}.meter{height:8px;background:#111820;border:1px solid #02060a;position:relative;overflow:hidden}.meter i{display:block;height:100%;transition:width .18s}.hpbar{background:linear-gradient(90deg,#a82932,#e65f54)}.mpbar{background:linear-gradient(90deg,#23589e,#4f97de)}.xpbar{background:linear-gradient(90deg,#577a3d,#98c269)}
#objective{position:absolute;top:10px;left:50%;transform:translateX(-50%);max-width:42%;font-size:12px;padding:8px 12px;z-index:8;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#areaHud{text-align:right;min-width:185px}#areaHud b{font-size:16px}#areaHud small{display:block;margin-top:4px;color:#e5cc8b}
#mini{position:absolute;right:12px;bottom:12px;width:130px;height:76px;background:#071019dc;border:1px solid var(--gold);z-index:7;border-radius:4px}
#toast{position:absolute;left:50%;bottom:18px;transform:translate(-50%,8px);opacity:0;transition:.18s;z-index:10;background:#071019ee;border:1px solid var(--gold);padding:8px 12px;font-size:12px;max-width:68%;text-align:center;box-shadow:0 4px 16px #0009}.showToast{opacity:1!important;transform:translate(-50%,0)!important}
#hint{position:absolute;left:50%;bottom:56px;transform:translateX(-50%);z-index:8;background:#071019db;border:1px solid #d8ac4eaa;padding:5px 9px;font-size:10px;opacity:0;transition:.15s}.hintOn{opacity:1!important}
#combo{position:absolute;left:16px;bottom:18px;z-index:8;color:#ffd46d;font-weight:bold;font-size:15px;text-shadow:0 2px 4px #000;opacity:0;transform:scale(.9);transition:.12s}.comboOn{opacity:1!important;transform:scale(1)!important}
#controls{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;padding:0 4px}
#dpad{display:grid;grid-template:48px 48px 48px/48px 48px 48px;gap:5px}.ctrl,.act{border:1px solid var(--gold2);background:linear-gradient(#11243a,#081321);box-shadow:inset 0 0 0 1px #000,0 3px 0 #02060a;border-radius:8px;touch-action:none;font-weight:700}.ctrl{width:48px;height:48px;font-size:19px}.ctrl:active,.act:active{transform:translateY(2px);box-shadow:inset 0 0 0 1px #000,0 1px 0 #02060a;filter:brightness(1.15)}#up{grid-column:2}#left{grid-column:1;grid-row:2}#down{grid-column:2;grid-row:2}#right{grid-column:3;grid-row:2}
#actions{display:grid;grid-template-columns:repeat(3,66px);grid-template-rows:48px 58px;gap:6px}.act{font-family:ui-monospace,Consolas,monospace;font-size:9px;height:48px}.act.skill{grid-column:1;grid-row:2;background:linear-gradient(#43235d,#211331);border-color:#8f66b5}.act.primary{grid-column:2/4;grid-row:2;width:138px;height:58px;background:linear-gradient(#174f91,#0c2d56);border-color:#d8ac4e;font-size:12px}.act.dodge{background:linear-gradient(#225d3a,#11321f);border-color:#5d9a6c}.coolText{font-size:8px;display:block;color:#d9ca9d}
#overlay{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:max(10px,env(safe-area-inset-top)) max(10px,env(safe-area-inset-right)) max(10px,env(safe-area-inset-bottom)) max(10px,env(safe-area-inset-left));background:#02060ad6;overflow:auto;touch-action:pan-y}.hidden{display:none!important}
.menuBackdrop{background-position:center;background-size:cover}.menuBackdrop:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#02060ae8 0 34%,#02060a55 62%,#02060ac4),linear-gradient(0deg,#02060ae8,#0000 55%);z-index:-1}.menuWrap{width:min(96vw,1040px);display:grid;grid-template-columns:minmax(310px,430px) 1fr;gap:18px;align-items:end;position:relative;min-height:min(88dvh,700px)}
.logo{font-size:clamp(34px,5vw,72px);line-height:.84;color:#f0d27d;text-shadow:0 3px 0 #4e2d0d,0 6px 16px #000;letter-spacing:.03em;text-transform:uppercase;margin:0 0 14px}.logo span{display:block;font-size:.58em;letter-spacing:.12em}.tagline{color:#d8c69b;max-width:420px;margin-bottom:18px;line-height:1.35}
.cardPanel{background:linear-gradient(180deg,#07111ef4,#080b10f7);border:1px solid var(--gold);box-shadow:inset 0 0 0 1px #000,0 14px 30px #000a;padding:16px;border-radius:6px}.cardPanel h2{margin:0 0 6px;color:#f0d27d;font-size:23px}.cardPanel p{color:var(--muted);font-family:ui-monospace,Consolas,monospace;font-size:11px;line-height:1.45}.field{display:grid;gap:5px;margin:10px 0}.field label{font-size:12px;color:#d6c494}.field input{width:100%;min-height:46px;border:1px solid #6d542e;background:#050a10;color:#efe3be;padding:10px 12px;outline:none;font-size:16px;border-radius:4px}.field input:focus{border-color:#e2bc61;box-shadow:0 0 0 2px #d8ac4e22}.menuBtns{display:grid;gap:8px;margin-top:12px}.menuBtn{min-height:46px;border:1px solid #806335;background:linear-gradient(#15283d,#0b1623);text-align:left;padding:10px 13px;font-weight:700;letter-spacing:.04em}.menuBtn.primary{background:linear-gradient(#1b5ba5,#0e3768);border-color:#d8ac4e;text-align:center;font-size:17px}.menuBtn:hover{filter:brightness(1.12)}.menuBtn[disabled]{opacity:.4}.error{color:#ef887f;min-height:17px;font-family:ui-monospace,Consolas,monospace;font-size:11px}.cloudPill{display:inline-flex;gap:6px;align-items:center;border:1px solid #506742;background:#0f1c16;padding:4px 7px;font-size:10px;color:#a5c797;font-family:ui-monospace,Consolas,monospace}.dot{width:7px;height:7px;border-radius:50%;background:#6c7c68}.dot.ok{background:#6fc879;box-shadow:0 0 7px #6fc879}
.classWrap{width:min(1000px,96vw)}.classHeader{text-align:center;margin-bottom:10px}.classHeader h2{color:#f0d27d;margin:0;font-size:28px}.classGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.classCard{min-height:460px;border:1px solid #70562d;background:#08111c center 22%/cover no-repeat;position:relative;overflow:hidden;cursor:pointer}.classCard:before{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#05090df8 0 37%,#05090d80 58%,#0001)}.classCard.sel{border-color:#f0c65e;box-shadow:inset 0 0 0 2px #f0c65e}.classInfo{position:absolute;left:0;right:0;bottom:0;padding:15px;z-index:2}.classInfo h3{margin:0;color:#f0d27d;font-size:24px}.classInfo p{font-family:ui-monospace,Consolas,monospace;font-size:10px;color:#ded0ae;line-height:1.4}.bars{display:grid;grid-template-columns:50px 1fr;gap:5px;font-family:ui-monospace,Consolas,monospace;font-size:9px}.statLine{height:5px;background:#1a2027}.statLine i{display:block;height:100%;background:#d7b75c}
.modal{width:min(920px,96vw);max-height:92dvh;overflow:auto;background:linear-gradient(#0b1522f5,#060b11f8);border:1px solid var(--gold);box-shadow:0 18px 50px #000c;padding:15px;border-radius:6px;position:relative}.modal h2{margin:0 0 8px;color:#f0d27d}.close{position:absolute;right:10px;top:8px;border:0;background:none;font-size:23px;color:#dec88d}.row{display:flex;justify-content:space-between;gap:10px;align-items:center;border-bottom:1px solid #6f542944;padding:9px 0}.row:last-child{border:0}.buy{border:1px solid #795f35;background:#13243a;padding:7px 10px;min-height:38px}.miniTxt{font-family:ui-monospace,Consolas,monospace;font-size:10px;color:#b8aa8a;line-height:1.4}
.invGrid{display:grid;grid-template-columns:250px 1fr 280px;gap:12px}.heroCard{min-height:430px;background:#08111c center 18%/cover no-repeat;border:1px solid #6e542b;position:relative;overflow:hidden}.heroCard:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#050a10f7 0 24%,#050a1033 70%)}.heroMeta{position:absolute;left:12px;right:12px;bottom:10px;z-index:2}.heroMeta h3{margin:0;color:#f0d27d;font-size:23px}.equipSlots{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.slot{min-height:78px;border:1px solid #71572f;background:#08101a;padding:7px;position:relative}.slot b{font-size:11px;color:#dfc481}.slot .ico{font-size:23px;display:block;margin-top:4px}.slot em{position:absolute;right:6px;bottom:5px;font-style:normal;font-size:9px;color:#b8aa8a}.itemGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.item{min-height:72px;border:1px solid #4b4a47;background:#080e16;padding:6px;text-align:center;position:relative}.item.sel{border-color:#f0c65e;box-shadow:inset 0 0 0 1px #f0c65e}.item .ico{font-size:26px}.item small{display:block;font-size:8px;color:#c9b98e;margin-top:3px;line-height:1.15}.rare{border-color:#4d76ad}.epic{border-color:#8c54c5}.legend{border-color:#d59a3d;box-shadow:inset 0 0 12px #d59a3d22}.detail{border:1px solid #6f542e;background:#08101a;padding:12px;min-height:330px}.detail h3{margin:0;color:#f0d27d}.detail .bigIco{font-size:52px;text-align:center;margin:20px}.rarity{font-size:11px;color:#a0b9db}.rarity.ep{color:#c894f0}.rarity.lg{color:#f0c15e}.statTable{margin:10px 0;border-top:1px solid #6f542955;border-bottom:1px solid #6f542955;padding:8px 0}.invTabs{display:flex;gap:5px;flex-wrap:wrap;margin:10px 0}.tab{border:1px solid #5c4a2d;background:#0c1724;padding:8px 10px}.tab.on{background:#154b88;border-color:#d8ac4e}.actionBar{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.actionBar button{flex:1;min-width:120px;min-height:42px}.danger{background:#5a1818!important;border-color:#a84b41!important}
.sceneSplash{position:fixed;inset:0;z-index:150;pointer-events:none;opacity:0;background:center/cover no-repeat;display:flex;align-items:flex-end;justify-content:center;transition:opacity .22s}.sceneSplash.on{opacity:1}.sceneSplash:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#0001,#03070de8)}.sceneText{position:relative;z-index:2;margin-bottom:12vh;text-align:center;text-shadow:0 3px 8px #000}.sceneText b{display:block;font-size:clamp(27px,5vw,58px);color:#f0d27d}.sceneText span{font-family:ui-monospace,Consolas,monospace;font-size:11px;color:#e7d9b8}
@media(max-width:720px){#shell{height:100dvh;gap:5px}.hudPanel{padding:5px 6px}#heroHud{grid-template-columns:34px 132px;min-width:174px;gap:5px}#portrait{width:34px;height:34px}#heroLine{font-size:11px}.hudStat{grid-template-columns:16px 1fr 42px;font-size:8px;gap:3px}.meter{height:6px}#objective{font-size:9px;padding:6px 8px;top:7px}#areaHud{min-width:120px;font-size:9px}#areaHud b{font-size:11px}#mini{width:90px;height:52px}.menuWrap{grid-template-columns:1fr;align-items:end;min-height:92dvh}.tagline{display:none}.logo{font-size:46px}.classGrid{grid-template-columns:1fr}.classCard{min-height:210px;background-position:center 20%}.classInfo p{display:none}.classInfo{padding:10px}.invGrid{grid-template-columns:1fr}.heroCard{min-height:230px}.detail{min-height:auto}.itemGrid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:620px) and (orientation:portrait){#shell{justify-content:center}#gameFrame{max-height:none}#controls{padding:0 6px}#dpad{grid-template:44px 44px 44px/44px 44px 44px}.ctrl{width:44px;height:44px}#actions{grid-template-columns:repeat(3,56px);grid-template-rows:44px 52px}.act{height:44px}.act.primary{width:118px;height:52px}.hudStat span:last-child{display:none}.hudStat{grid-template-columns:16px 1fr}.logo{font-size:40px}.cardPanel{padding:13px}}
@media(orientation:landscape) and (max-height:620px){#shell{height:100dvh;padding:4px;gap:0}#gameFrame{max-height:100dvh;width:min(100%,calc(100dvh * 16 / 9))}#controls{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);width:min(96vw,1060px);pointer-events:none;z-index:20;padding:0 10px}#controls button{pointer-events:auto;background-color:#07101ddd}#dpad{grid-template:44px 44px 44px/44px 44px 44px}.ctrl{width:44px;height:44px}#actions{grid-template-columns:repeat(3,58px);grid-template-rows:42px 52px}.act{height:42px}.act.primary{width:122px;height:52px}#mini{bottom:92px}.modal{max-height:96dvh}.classCard{min-height:86dvh}}

/* v6 landscape-first immersive HUD */
@media (orientation:landscape){
 #shell{width:100vw;height:100dvh;max-width:none;max-height:none;padding:0;gap:0;overflow:hidden}
 #gameFrame{width:min(100vw,calc(100dvh * 16 / 9));height:min(100dvh,calc(100vw * 9 / 16));max-height:none;aspect-ratio:16/9;border-width:1px}
 #controls{position:absolute;inset:0;pointer-events:none;z-index:22;padding:0}
 #controls button{pointer-events:auto}
 #dpad{position:absolute;left:max(16px,env(safe-area-inset-left));bottom:max(16px,env(safe-area-inset-bottom));display:grid;grid-template:54px 54px 54px/54px 54px 54px;gap:3px;filter:drop-shadow(0 6px 12px #0009)}
 .ctrl{width:54px;height:54px;border-radius:50%;background:radial-gradient(circle at 45% 35%,#20334bcf,#07111ce8 70%);font-size:20px;opacity:.92}
 #actions{position:absolute;right:max(16px,env(safe-area-inset-right));bottom:max(14px,env(safe-area-inset-bottom));width:238px;height:168px;display:block}
 .act{position:absolute;border-radius:50%;background:radial-gradient(circle at 42% 35%,#233951ef,#07111cf2 72%);box-shadow:inset 0 0 0 2px #0008,0 5px 16px #0009}
 #atkBtn{right:0;bottom:0;width:92px!important;height:92px!important;font-size:12px!important;background:radial-gradient(circle at 42% 35%,#8d5b20,#2c170b 72%)!important}
 #skillBtn{right:18px;top:0;width:66px;height:66px!important;background:radial-gradient(circle at 42% 35%,#623884,#241333 72%)!important}
 #dodgeBtn{right:92px;top:32px;width:62px;height:62px!important;background:radial-gradient(circle at 42% 35%,#27684a,#102d20 72%)!important}
 #useBtn{left:0;bottom:0;width:58px;height:58px!important}
 #invBtn{left:64px;bottom:0;width:58px;height:58px!important;border-radius:12px}
 #mini{right:14px;bottom:190px;width:116px;height:68px;opacity:.92}
 #toast{bottom:18px;max-width:42%}#hint{bottom:78px}
 #hud{top:max(8px,env(safe-area-inset-top));left:max(10px,env(safe-area-inset-left));right:max(10px,env(safe-area-inset-right))}
 #objective{top:max(8px,env(safe-area-inset-top));max-width:38%;font-size:11px}
 #heroHud{grid-template-columns:46px 180px;min-width:240px}.hudPanel{backdrop-filter:blur(4px)}#portrait{width:46px;height:46px}
}
#rotateNotice{display:none}
@media (orientation:portrait) and (max-width:800px){#rotateNotice{display:flex;position:fixed;inset:0;z-index:300;align-items:center;justify-content:center;text-align:center;padding:32px;background:#02060af2;color:#f0d27d;font-size:22px}#rotateNotice small{display:block;color:#b8aa8a;font-size:13px;margin-top:8px}}

/* v7 mobile fullscreen final */
html,body,#app{width:100%;height:100%;min-height:100dvh;background:#02060a}
body{position:fixed;inset:0}
#controls{z-index:40}
#joystick{width:150px;height:150px;position:relative;touch-action:none;pointer-events:auto;filter:drop-shadow(0 8px 16px #000a)}
#joyRing{position:absolute;inset:7px;border-radius:50%;border:2px solid #d8ac4eaa;background:radial-gradient(circle at 50% 50%,#14243ad9 0 31%,#07111ddd 32% 66%,#02070bbb 67%);box-shadow:inset 0 0 0 2px #0008,inset 0 0 28px #0008,0 0 0 1px #0008}
#joyRing:before,#joyRing:after{content:"";position:absolute;background:#e5ca7b55;left:50%;top:50%;transform:translate(-50%,-50%)}#joyRing:before{width:1px;height:72%}#joyRing:after{width:72%;height:1px}
#joyKnob{position:absolute;left:50%;top:50%;width:58px;height:58px;margin:-29px;border-radius:50%;background:radial-gradient(circle at 38% 30%,#50637a,#172538 62%,#09111b);border:2px solid #c7b078;box-shadow:inset 0 0 0 2px #0008,0 5px 12px #000a;will-change:transform}
#actions .act{display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1;font-family:ui-monospace,Consolas,monospace;backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
#actions .act>span:not(.coolText){font-size:8px;margin-top:4px;letter-spacing:.03em}.coolText{position:absolute;right:4px;bottom:3px;font-size:8px;color:#fff4c9}
@media (orientation:landscape){
 #app,#shell{position:fixed;inset:0;width:100vw;height:100dvh;max-width:none;max-height:none;margin:0;padding:0;overflow:hidden}
 #gameFrame{position:absolute;inset:0;width:100vw;height:100dvh;max-height:none;aspect-ratio:auto;margin:0;border:0;box-shadow:none;background:#02060a}
 #gameFrame:after{box-shadow:inset 0 0 42px #0007}
 #game{position:absolute;left:50%;top:50%;width:max(100vw,calc(100dvh * 16 / 9));height:max(100dvh,calc(100vw * 9 / 16));transform:translate(-50%,-50%);max-width:none;max-height:none}
 #scan{opacity:.18}
 #controls{position:fixed;inset:0;width:100vw;height:100dvh;pointer-events:none;padding:0;transform:none}
 #joystick{position:absolute;left:max(18px,env(safe-area-inset-left));bottom:max(18px,env(safe-area-inset-bottom))}
 #actions{position:absolute;right:max(18px,env(safe-area-inset-right));bottom:max(14px,env(safe-area-inset-bottom));width:220px;height:178px;display:block}
 #atkBtn{position:absolute;right:0;bottom:0;width:92px!important;height:92px!important;border-radius:50%!important;font-size:25px!important;background:radial-gradient(circle at 40% 30%,#a76b27,#3a1d0c 70%)!important;border:2px solid #e2bb58!important;box-shadow:inset 0 0 0 2px #0008,0 0 0 2px #6c4318,0 7px 18px #000a!important}
 #skillBtn{position:absolute;right:17px;top:0;width:64px!important;height:64px!important;border-radius:50%!important;font-size:20px!important}
 #dodgeBtn{position:absolute;right:96px;bottom:18px;width:62px!important;height:62px!important;border-radius:50%!important;font-size:18px!important}
 #useBtn{position:absolute;right:96px;top:14px;width:54px!important;height:54px!important;border-radius:50%!important;font-size:16px!important}
 #invBtn{position:absolute;left:0;bottom:10px;width:54px!important;height:54px!important;border-radius:15px!important;font-size:16px!important}
 #mini{top:max(74px,calc(env(safe-area-inset-top) + 64px));right:max(12px,env(safe-area-inset-right));bottom:auto;width:112px;height:66px;opacity:.9}
 #hud{top:max(8px,env(safe-area-inset-top));left:max(10px,env(safe-area-inset-left));right:max(10px,env(safe-area-inset-right))}
 #objective{top:max(8px,env(safe-area-inset-top));max-width:34vw;font-size:10px;padding:6px 9px}
 #areaHud{margin-right:0}.hudPanel{background:linear-gradient(180deg,#07101ed9,#08111ad2);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px)}
 #toast{bottom:max(16px,env(safe-area-inset-bottom));max-width:38%;pointer-events:none}#hint{bottom:max(76px,calc(env(safe-area-inset-bottom) + 66px))}
 #combo{left:max(18px,env(safe-area-inset-left));bottom:180px}
}
@media (orientation:landscape) and (max-height:430px){
 #joystick{width:126px;height:126px}#joyKnob{width:50px;height:50px;margin:-25px}
 #actions{transform:scale(.88);transform-origin:bottom right;right:max(8px,env(safe-area-inset-right));bottom:max(6px,env(safe-area-inset-bottom))}
 #heroHud{grid-template-columns:38px 152px;min-width:198px}#portrait{width:38px;height:38px}#heroLine{font-size:11px}.hudStat{font-size:8px;grid-template-columns:18px 1fr 46px}.meter{height:6px}
 #areaHud{min-width:142px}#areaHud b{font-size:12px}#objective{max-width:30vw;font-size:9px}
 #mini{width:88px;height:52px;top:60px}
}

</style>
</head>
<body><div id="rotateNotice"><div>↻ Gire o celular para jogar<div><small>Crônicas do Ferro foi otimizado para modo horizontal.</small></div></div></div>
<div id="app"><div id="shell">
<div id="gameFrame">
<canvas id="game" width="800" height="450"></canvas><canvas id="mini" width="130" height="76"></canvas><div id="scan"></div>
<div id="hud"><div id="heroHud" class="hudPanel"><div id="portrait"></div><div><div id="heroLine">—</div><div class="hudStat"><span>PV</span><div class="meter"><i id="hpBar" class="hpbar"></i></div><span id="hpTxt">—</span></div><div class="hudStat"><span>PM</span><div class="meter"><i id="mpBar" class="mpbar"></i></div><span id="mpTxt">—</span></div><div class="hudStat"><span>XP</span><div class="meter"><i id="xpBar" class="xpbar"></i></div><span id="xpTxt">—</span></div></div></div><div id="areaHud" class="hudPanel"><b id="areaName">—</b><small><span id="goldTxt">0 ouro</span> · <span id="levelTxt">Nv. 1</span></small></div></div>
<div id="objective" class="hudPanel">Objetivo: —</div><div id="hint">USAR · Interagir</div><div id="combo"></div><div id="toast"></div><div id="overlay"></div>
</div>
<div id="controls"><div id="joystick" aria-label="Movimento"><div id="joyRing"><div id="joyKnob"></div></div></div><div id="actions"><button class="act" id="invBtn" aria-label="Inventário">🎒<span>BOLSA</span></button><button class="act" id="useBtn" aria-label="Usar ou interagir">🧪<span>USAR</span></button><button class="act dodge" id="dodgeBtn" aria-label="Esquiva">➤<span>ESQ</span><span class="coolText" id="dodgeCool"></span></button><button class="act skill" id="skillBtn" aria-label="Habilidade">✦<span>HABIL.</span><span class="coolText" id="skillCool"></span></button><button class="act primary" id="atkBtn" aria-label="Atacar">⚔<span>ATACAR</span></button></div></div>
</div></div>
<div id="sceneSplash" class="sceneSplash"><div class="sceneText"><b id="sceneTitle"></b><span id="sceneSub"></span></div></div>
